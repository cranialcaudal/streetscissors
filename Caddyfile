# Production Caddyfile
#
# IMPORTANT: Replace 'email@example.com' with your actual email for Let's Encrypt notifications!
#

# HTTP/3 disabled: deploys SIGKILL caddy, leaving browsers (esp. Firefox) with
# wedged QUIC connections — every page load then hangs until a browser restart.
{
    servers {
        protocols h1 h2
    }
}

# Redirect www to non-www
www.streetscissors.com {
    redir https://streetscissors.com{uri}
}

streetscissors.com, 10.0.0.187, 100.100.33.116 {
    # Replace with your email address to avoid rate limits
    tls admin@streetscissors.com

    # Block Bad Bots. This is a `handle` rather than a bare `respond` because
    # the media block below is one too: `handle` blocks are mutually exclusive
    # and run in the order written, whereas Caddy's own directive ordering puts
    # every `handle` ahead of every `respond` — which would let a blocked bot
    # straight through to the files.
    @bad_bots {
        header User-Agent *DotBot*
        header User-Agent *PetalBot*
        header User-Agent *MJ12bot*
        header User-Agent *AhrefsBot*
        header User-Agent *SemrushBot*
        header User-Agent *GPTBot*
        header User-Agent *ClaudeBot*
        header User-Agent *Bytespider*
    }
    handle @bad_bots {
        respond "Access Denied" 403
    }

    # ── Media ────────────────────────────────────────────────────────────
    # Uploaded media is served straight off disk, ahead of the app.
    #
    # A page of HLS video is hundreds of small segment requests, and none of
    # them should occupy a BEAM scheduler: Caddy does Range, ETag and
    # sendfile natively and stays out of Phoenix's way. `WebWeb.Plugs.MediaServe`
    # remains the equivalent for `mix phx.server`, where there is no Caddy.
    #
    # The two Content-Type lines are not optional. Neither extension is in
    # Go's MIME table, and hls.js refuses a playlist served as
    # application/octet-stream — the player fails with no useful error.
    #
    # Everything under an entry directory is immutable: a re-transcode writes
    # a NEW directory and swaps the pointer on the row (see Web.Uploads), so
    # nothing at a given path ever changes and `immutable` is honest.
    handle_path /uploads/* {
        # Relative to Caddy's working directory, and deliberately so: an
        # absolute path here would write a home directory — and a username —
        # into a public repository. Set UPLOADS_ROOT if Caddy is ever started
        # from somewhere else, the way the app itself takes UPLOADS_PATH.
        root * {$UPLOADS_ROOT:../streetscissors-data/uploads}
        header Cache-Control "public, max-age=31536000, immutable"
        @m3u8 path *.m3u8
        header @m3u8 Content-Type "application/vnd.apple.mpegurl"
        @m4s path *.m4s
        header @m4s Content-Type "video/iso.segment"
        file_server
    }

    # Everything else is the Phoenix app.
    handle {
        reverse_proxy localhost:4000
    }

    # Compression
    encode gzip zstd

    # Security Headers
    header {
        # Keep referrer data secure
        Referrer-Policy "strict-origin-when-cross-origin"
        # Prevent clickjacking
        X-Frame-Options "SAMEORIGIN"
        # Prevent sniffing MIME types
        X-Content-Type-Options "nosniff"
        # HSTS (Strict-Transport-Security) - Uncomment after testing!
        # Strict-Transport-Security "max-age=31536000;"
        # Remove Server header for obscurity
        -Server
    }

    # Logging (Optional but recommended)
    log {
        output file ./caddy_access.log
    }
}
