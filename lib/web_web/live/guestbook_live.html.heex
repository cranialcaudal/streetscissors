<div class="container">
  <header class="guestbook-header" style="padding: 1rem 0; text-align: left;">
    <h1 style="margin: 0; font-size: 3rem; color: var(--accent-color); font-family: var(--font-heading); text-transform: lowercase;">
      guestbook
    </h1>
  </header>

  <div class="glass-panel" style="padding: 2rem; min-height: 60vh; position: relative;">
    <div
      class="guestbook-form"
      style="background: rgba(0,0,0,0.3); padding: 1.5rem; border-radius: 8px; border: 1px solid rgba(194, 69, 29, 0.3); margin-bottom: 3rem;"
    >
      <h3 style="color: white; margin-bottom: 1rem; font-family: var(--font-heading);">
        Sign the Guestbook
      </h3>
      <.form for={@form} phx-change="validate" phx-submit="save">
        <div style="margin-bottom: 1rem;">
          <.input
            field={@form[:name]}
            type="text"
            placeholder="Your Name"
            style="width: 100%; padding: 0.5rem; background: rgba(23, 20, 15, 0.1); border: 1px solid #333; color: white;"
          />
        </div>
        <div style="margin-bottom: 1rem;">
          <.input
            field={@form[:message]}
            type="textarea"
            placeholder="Your Message"
            style="width: 100%; padding: 0.5rem; background: rgba(23, 20, 15, 0.1); border: 1px solid #333; color: white; min-height: 100px;"
          />
          <div style="text-align: right; margin-top: 0.5rem;">
            <WebWeb.CoreComponents.grammar_button class="btn-xs" />
          </div>
        </div>

        <div style="margin-bottom: 1rem;">
          <WebWeb.CaptchaHTML.simple_text text={@captcha_question} />
          <input
            name="captcha"
            type="text"
            placeholder="Answer..."
            style="width: 100%; padding: 0.5rem; background: rgba(23, 20, 15, 0.1); border: 1px solid #333; color: white;"
            required
            autocomplete="off"
          />
        </div>

        <div style="display: flex; align-items: center; justify-content: space-between;">
          <button
            type="submit"
            phx-disable-with="Signing..."
            style="background: var(--accent-color); color: black; border: none; padding: 0.5rem 1.5rem; font-weight: bold; cursor: pointer; font-family: var(--font-heading); text-transform: uppercase;"
          >
            Sign
          </button>
          <!-- Check button moved to be near textarea for better context, or here? I put it near textarea above -->
        </div>
      </.form>
    </div>

    <div class="guestbook-entries" style="margin-bottom: 2rem; position: relative; z-index: 1;">
      <h3 style="color: white; margin-bottom: 1rem; font-family: var(--font-heading);">
        Recent Signatures
      </h3>
      <%= if Enum.empty?(@entries) do %>
        <p style="text-align: center; color: var(--ink-3); font-style: italic;">
          Be the first to sign the guestbook.
        </p>
      <% else %>
        <%= for entry <- @entries do %>
          <div
            class="guestbook-entry"
            style="margin-bottom: 1.5rem; border-bottom: 1px solid rgba(23, 20, 15, 0.1); padding-bottom: 1rem; position: relative;"
          >
            <div style="font-weight: bold; color: var(--accent-color); margin-bottom: 0.5rem;">
              {entry.name}
              <span style="font-weight: normal; font-size: 0.8em; color: var(--ink-3);">
                says:
              </span>
            </div>
            <div style="color: var(--ink-2); white-space: pre-wrap;">{entry.message}</div>
            <div style="font-size: 0.8rem; color: var(--ink-4); margin-top: 0.5rem; text-align: right;">
              {Calendar.strftime(entry.inserted_at, "%Y-%m-%d")}
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <%!-- The inline admin login, IP display and per-entry delete that used to
          live here were a pre-AdminAuth scheme: `admin_mode` was hardcoded
          false, so the password box rendered to every visitor and its
          `admin_login` event had no handler at all — submitting it crashed the
          LiveView. Moderation belongs to /admin/guestbook, which is gated by
          the live_session :admin hook. --%>

    <WebWeb.CoreComponents.grammar_panel matches={@grammar_matches} />
  </div>
</div>
