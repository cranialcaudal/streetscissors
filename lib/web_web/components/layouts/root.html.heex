<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#17140f" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="streetscissors" />
    
<!-- PWA Manifest & App Icons -->
    <link rel="manifest" href={~p"/manifest.json"} />
    <%!-- The tab's icon at the sizes a tab shows it. These were both the
          1024-pixel share image, 460 KB, fetched by every first visit to
          draw sixteen pixels. --%>
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/images/favicon-32.png"} />
    <link rel="icon" type="image/png" sizes="16x16" href={~p"/images/favicon-16.png"} />
    <link rel="apple-touch-icon" sizes="180x180" href={~p"/images/apple-touch-icon.png"} />
    
<!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=IBM+Plex+Mono:wght@400;500;600&family=League+Spartan:wght@400;500;600;700;800&family=Saira+Condensed:wght@400;500;600;700&family=Sorts+Mill+Goudy:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <%!-- Per-page metadata (WebWeb.SEO). Pages assign :page_title,
          :og_title, :og_description, :canonical_path, :og_type — all of it
          falls back to site defaults. --%>
    <meta name="description" content={WebWeb.SEO.description(assigns)} />
    <%!-- Only unlisted pages emit this; everything else is indexable by default. --%>
    <meta
      :if={WebWeb.SEO.robots(assigns)}
      name="robots"
      content={WebWeb.SEO.robots(assigns)}
    />
    <link
      :if={WebWeb.SEO.canonical_url(assigns)}
      rel="canonical"
      href={WebWeb.SEO.canonical_url(assigns)}
    />

    <meta property="og:site_name" content={WebWeb.SEO.site_name()} />
    <meta property="og:type" content={WebWeb.SEO.og_type(assigns)} />
    <meta property="og:title" content={WebWeb.SEO.og_title(assigns)} />
    <meta property="og:description" content={WebWeb.SEO.description(assigns)} />
    <%!-- Absolute, or no unfurler will fetch it. --%>
    <meta property="og:image" content={WebWeb.SEO.og_image(assigns)} />
    <meta
      :if={WebWeb.SEO.canonical_url(assigns)}
      property="og:url"
      content={WebWeb.SEO.canonical_url(assigns)}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={WebWeb.SEO.og_title(assigns)} />
    <meta name="twitter:description" content={WebWeb.SEO.description(assigns)} />
    <meta name="twitter:image" content={WebWeb.SEO.og_image(assigns)} />

    <%!-- Site-wide structured data: ties the site to its exact brand name
          and to its author (name from config). No `sameAs` — deliberately not
          cross-linked to any other profile. Tags are built as full strings
          in WebWeb.SEO and raw/1'd here — see its moduledoc note on why a
          literal <script> in this template can't hold a HEEx expression. --%>
    {raw(WebWeb.SEO.person_json_ld_tag())}
    {raw(WebWeb.SEO.website_json_ld_tag())}
    {raw(WebWeb.SEO.page_json_ld_tag(assigns))}

    <%!-- Lets browsers and feed readers discover the feeds: the whole site,
          and — when a page is filtered on a keyword — that keyword's thread
          (`@keyword_feed`, set by the blog and logs indexes). --%>
    <link rel="alternate" type="application/rss+xml" title="streetscissors" href={~p"/feed"} />
    <%!-- rel="me" is opt-in (REL_ME_URLS): the site links to no other
          profile unless its owner lists one — see SEO.person_json_ld_tag/0. --%>
    <link :for={url <- Application.get_env(:web, :rel_me, [])} rel="me" href={url} />
    <%!-- Where other sites send webmentions when they cite a piece
          (WebWeb.WebmentionController). --%>
    <link rel="webmention" href={WebWeb.SEO.absolute(~p"/webmention")} />
    <link
      :if={assigns[:keyword_feed]}
      rel="alternate"
      type="application/rss+xml"
      title={"streetscissors · #{assigns[:keyword]}"}
      href={assigns[:keyword_feed]}
    />

    <.live_title default="streetscissors" suffix="">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <%!-- esbuild runs with --splitting --format=esm so the video player can be a
         lazy chunk, which means the bundle is an ES module. Module scripts are
         deferred by default, so `defer` is implied rather than dropped. --%>
    <script phx-track-static type="module" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <div id="main-content-wrapper" class="main-content-wrapper">
      {@inner_content}
    </div>
    <style>
      .main-content-wrapper { padding-top: 1rem; }
      @media (max-width: 800px) {
        .main-content-wrapper { padding-top: 0 !important; }
      }
    </style>

    <%!-- What an admin sees on the public pages: a way back in and a way
          out. Styled in admin.css (#admin-indicator). Not rendered inside
          the admin itself, where the rail already says all of this. --%>
    <%= if assigns[:admin_mode] && !assigns[:admin_chrome] do %>
      <div id="admin-indicator">
        <span class="admin-indicator-label">
          <.icon name="hero-shield-check" class="size-4" /> Admin
        </span>
        <a href={~p"/admin/dashboard"} aria-label="Admin overview" title="Admin overview">
          <.icon name="hero-squares-2x2" class="size-4" />
        </a>
        <form action={~p"/admin/logout"} method="post">
          <input type="hidden" name="_method" value="delete" />
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <button type="submit" aria-label="Log out" title="Log out">
            <.icon name="hero-arrow-right-on-rectangle" class="size-4" />
          </button>
        </form>
      </div>
    <% end %>
    {live_render(
      Map.get(assigns, :socket) || Map.get(assigns, :conn),
      WebWeb.NewsletterOverlayLive,
      id: "newsletter-overlay",
      sticky: true,
      layout: false
    )}
  </body>
</html>
