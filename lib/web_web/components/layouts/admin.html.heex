<%!-- The composing room: rail on the left, the page on the right. Everything
      it wears is in assets/css/admin.css; the rail and its counts come from
      WebWeb.AdminNav (on_mount), so a page only renders its own content. --%>
<div class="admin-layout">
  <WebWeb.AdminComponents.rail
    path={assigns[:admin_path]}
    counts={assigns[:admin_counts] || %{}}
  />

  <main id="adm-main" class="adm-main">
    <.flash_group flash={@flash} />
    <div class="adm-page">
      {@inner_content}
    </div>
  </main>
</div>
