<div class="england-container">
  <header class="england-header">
    <div class="title-row">
      <h1 class="page-title">England 2026</h1>
    </div>
    <p class="mission-sub">London &amp; the Lake District &middot; 5&ndash;17 July 2026</p>
    <div class="abbey-crossing" aria-hidden="true"></div>

    <div class="nav-tabs">
      <button class="tab-btn active" data-tab="calendar" onclick="showTab('calendar')">
        Calendar
      </button>
      <button class="tab-btn" data-tab="itinerary" onclick="showTab('itinerary')">
        Itinerary
      </button>
      <button class="tab-btn" data-tab="checklist" onclick="showTab('checklist')">
        Packing
      </button>
      <button class="tab-btn" data-tab="routes" onclick="showTab('routes')">
        Routes
      </button>
    </div>
  </header>

  <div id="calendar" class="tab-content active">
    <div class="cal-frame">
      <div class="cal-month">July 2026</div>
      <div class="cal-grid">
        <div :for={dow <- ~w(Sun Mon Tue Wed Thu Fri Sat)} class="cal-dow">{dow}</div>
        <%= for week <- @calendar_weeks, day <- week do %>
          <%= if day && @trip_days[day] do %>
            <button class="cal-cell trip" onclick={"jumpToDay(#{@trip_days[day].num})"}>
              <span class="cal-head">
                <span class="cal-date">{day}</span>
                <span class="cal-mission">Day {@trip_days[day].num}</span>
              </span>
              <span class="cal-icon">{@trip_days[day].icon}</span>
              <span class="cal-title">{@trip_days[day].title}</span>
            </button>
          <% else %>
            <div class={["cal-cell", if(day, do: "off", else: "blank")]}>
              <span :if={day} class="cal-date">{day}</span>
            </div>
          <% end %>
        <% end %>
      </div>
      <div class="cal-legend">
        <span class="legend-chip"></span> trip day &mdash; tap one for the day's plan
      </div>
    </div>

    <a href="/england2026/call" class="call-page-btn">
      📞 Mom &amp; Dad — the best times to call me
    </a>
  </div>

  <div id="itinerary" class="tab-content">
    <div class="england-prose">
      {raw(@itinerary)}
    </div>
  </div>

  <div id="checklist" class="tab-content">
    <div class="england-prose">
      {raw(@checklist)}
    </div>
  </div>

  <div id="routes" class="tab-content">
    <div class="komoot-placeholder">
      <h3>Routes</h3>
      <p>
        Rides are synced from Komoot and archived as interactive maps on the <a
          href="/fitness/rides"
          class="routes-link"
        >GPX Action page</a>.
      </p>

      <div class="route-list">
        <a href="/fitness/rides" class="route-item">
          <span class="route-name">Fred Whitton Challenge 2026</span>
          <span class="route-status">Planned</span>
        </a>
        <a href="/fitness/rides" class="route-item">
          <span class="route-name">London to Dover (The Long Way)</span>
          <span class="route-status">Planned</span>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .england-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1rem 5rem 1rem;
    --uj-red: #C8102E;
    --font-cal: 'Californian FB', 'Sorts Mill Goudy', Georgia, serif;
    --ivory: #f2eee3;
    --ink: #d9d4c5;
    --muted: #9a9283;
    --faint: #6b6557;
    --hairline: rgba(242, 238, 227, 0.14);
    --hairline-soft: rgba(242, 238, 227, 0.07);
    font-family: var(--font-cal);
  }

  .england-header {
    margin-bottom: 3rem;
    text-align: center;
  }

  .title-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .page-title {
    font-family: var(--font-cal);
    font-weight: 400;
    font-size: 3.4rem;
    letter-spacing: 1px;
    color: var(--ivory);
    margin: 0;
  }

  .mission-sub {
    margin-top: 0.5rem;
    color: var(--muted);
    font-family: var(--font-cal);
    font-style: italic;
    font-size: 1.05rem;
    letter-spacing: 1px;
  }

  /* ── Abbey Road zebra-crossing divider ─────────────────────── */
  .abbey-crossing {
    height: 10px;
    max-width: 420px;
    margin: 1.5rem auto 2rem auto;
    background: repeating-linear-gradient(90deg, #ddd8ca 0 32px, #0a0a0a 32px 64px);
    border-top: 1px solid #1c1c1c;
    border-bottom: 1px solid #1c1c1c;
    border-radius: 1px;
    opacity: 0.85;
  }

  .nav-tabs {
    display: flex;
    justify-content: center;
    gap: 2.25rem;
    flex-wrap: wrap;
  }

  .tab-btn {
    padding: 0.35rem 0.15rem;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    font-family: var(--font-cal);
    font-size: 1.15rem;
    color: var(--muted);
    letter-spacing: 0.5px;
    text-transform: none;
    transition: color 0.2s, border-color 0.2s;
  }

  .tab-btn:hover {
    color: var(--ivory);
  }

  .tab-btn.active {
    color: var(--ivory);
    border-bottom-color: var(--uj-red);
  }

  .tab-content {
    display: none;
    animation: fadeIn 0.4s ease-out;
  }

  .tab-content.active {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── Calendar ──────────────────────────────────────────────── */
  .cal-frame {
    border: 1px solid var(--hairline);
    border-radius: 3px;
    padding: 1.75rem;
  }

  .cal-month {
    text-align: center;
    font-family: var(--font-cal);
    font-weight: 400;
    font-variant: small-caps;
    letter-spacing: 6px;
    font-size: 1.5rem;
    color: var(--ivory);
    margin-bottom: 1.25rem;
  }

  .cal-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
  }

  .cal-dow {
    text-align: center;
    font-family: var(--font-cal);
    font-variant: small-caps;
    font-size: 0.9rem;
    letter-spacing: 2px;
    color: var(--faint);
    padding-bottom: 0.4rem;
  }

  .cal-cell {
    min-height: 108px;
    border-radius: 2px;
    padding: 0.45rem 0.55rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
    text-align: left;
    font-family: var(--font-cal);
    text-transform: none;
  }

  .cal-cell.blank {
    background: transparent;
  }

  .cal-cell.off {
    border: 1px solid var(--hairline-soft);
  }

  .cal-cell.off .cal-date {
    color: #4a463c;
  }

  .cal-cell.trip {
    cursor: pointer;
    border: 1px solid var(--hairline);
    border-top: 2px solid var(--uj-red);
    background: rgba(242, 238, 227, 0.03);
    transition: background 0.15s ease-out, border-color 0.15s ease-out;
  }

  .cal-cell.trip:hover {
    background: rgba(242, 238, 227, 0.07);
    border-color: rgba(242, 238, 227, 0.35);
    border-top-color: var(--uj-red);
  }

  .cal-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    width: 100%;
  }

  .cal-date {
    color: #8d8778;
    font-size: 1rem;
  }

  .cal-cell.trip .cal-date {
    color: var(--ivory);
  }

  .cal-mission {
    font-style: italic;
    font-size: 0.72rem;
    color: var(--muted);
  }

  .cal-icon {
    font-size: 1.05rem;
    line-height: 1;
  }

  .cal-title {
    font-size: 0.8rem;
    color: var(--ivory);
    line-height: 1.3;
  }

  .cal-legend {
    margin-top: 1.25rem;
    text-align: center;
    color: var(--muted);
    font-style: italic;
    font-size: 0.9rem;
  }

  .legend-chip {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 1px;
    vertical-align: -1px;
    margin-right: 0.4rem;
    background: rgba(242, 238, 227, 0.05);
    border: 1px solid var(--hairline);
    border-top: 2px solid var(--uj-red);
  }

  /* ── Call-times button (calendar tab) ──────────────────────── */
  .call-page-btn {
    display: block;
    margin: 1.5rem auto 0 auto;
    max-width: 420px;
    text-align: center;
    padding: 0.8rem 1.2rem;
    border-radius: 2px;
    font-family: var(--font-cal);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--ivory);
    border: 1px solid var(--hairline);
    transition: border-color 0.15s ease-out;
  }

  .call-page-btn:hover {
    border-color: var(--uj-red);
  }

  /* ── Prose (itinerary + packing markdown) ──────────────────── */
  .england-prose {
    max-width: 46rem;
    margin: 0 auto;
    font-family: var(--font-cal);
    font-size: 1.15rem;
    line-height: 1.75;
    color: var(--ink);
  }

  .england-prose h1 {
    font-family: var(--font-cal);
    font-weight: 400;
    font-size: 2.1rem;
    line-height: 1.25;
    color: var(--ivory);
    text-align: center;
    margin: 0.5rem 0 1rem 0;
  }

  .england-prose h2 {
    font-family: var(--font-cal);
    font-weight: 400;
    font-size: 1.6rem;
    line-height: 1.3;
    color: var(--ivory);
    margin: 2.75rem 0 1rem 0;
    scroll-margin-top: 2rem;
  }

  .england-prose h3 {
    font-family: var(--font-cal);
    font-weight: 400;
    font-style: italic;
    font-size: 1.25rem;
    color: var(--ivory);
    margin: 2rem 0 0.75rem 0;
  }

  .england-prose p {
    font-family: var(--font-cal);
    margin: 0 0 1.1rem 0;
  }

  .england-prose strong,
  .england-prose em {
    font-family: inherit;
  }

  .england-prose strong {
    color: var(--ivory);
  }

  .england-prose a {
    color: var(--ivory);
    text-decoration: underline;
    text-decoration-color: var(--uj-red);
    text-underline-offset: 3px;
  }

  .england-prose hr {
    border: none;
    border-top: 1px solid var(--hairline);
    max-width: 220px;
    margin: 2.75rem auto;
  }

  .england-prose blockquote {
    margin: 1.5rem 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--uj-red);
    font-style: italic;
    color: var(--muted);
  }

  .england-prose ul,
  .england-prose ol {
    list-style: disc;
    margin: 0 0 1.25rem 0;
    padding-left: 1.4rem;
  }

  .england-prose ol {
    list-style: decimal;
  }

  .england-prose li {
    margin-bottom: 0.5rem;
  }

  .england-prose li::marker {
    color: var(--uj-red);
  }

  .england-prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0 1.75rem 0;
  }

  .england-prose th {
    font-weight: 400;
    font-variant: small-caps;
    letter-spacing: 1.5px;
    color: var(--muted);
    text-align: left;
    padding: 0.3rem 1rem 0.4rem 0;
    border-bottom: 1px solid var(--hairline);
  }

  .england-prose td {
    padding: 0.5rem 1rem 0.5rem 0;
    border-bottom: 1px solid var(--hairline-soft);
    vertical-align: top;
  }

  .england-prose td:first-child {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* ── Packing checklist (Earmark GFM output) ────────────────── */
  .tab-content#checklist ul {
    list-style: none !important;
    padding-left: 0.25rem !important;
  }

  .tab-content#checklist li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.65rem !important;
    color: var(--ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    -webkit-user-select: none;
    user-select: none;
  }

  .tab-content#checklist input[type="checkbox"] {
    accent-color: var(--uj-red);
    width: 1.25rem;
    height: 1.25rem;
    cursor: pointer;
    margin-top: 0.3rem;
    flex-shrink: 0;
  }

  .tab-content#checklist li:has(input[type="checkbox"]:checked) {
    color: var(--faint);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  /* Bag-section labels ("Bike", "Rhinowalk frame bag", …) */
  .tab-content#checklist .england-prose p > strong:only-child {
    font-variant: small-caps;
    letter-spacing: 2px;
  }

  /* ── Routes placeholder ────────────────────────────────────── */
  .komoot-placeholder {
    text-align: center;
    padding: 4rem 2rem;
    border: 1px solid var(--hairline);
    border-radius: 3px;
    margin-top: 1rem;
  }

  .komoot-placeholder h3 {
    font-family: var(--font-cal);
    font-weight: 400;
    font-variant: small-caps;
    letter-spacing: 4px;
    font-size: 1.5rem;
    color: var(--ivory);
    margin-bottom: 1rem;
  }

  .komoot-placeholder p {
    color: var(--muted);
    margin-bottom: 2rem;
  }

  .routes-link {
    color: var(--ivory);
    text-decoration: underline;
    text-decoration-color: var(--uj-red);
    text-underline-offset: 3px;
  }

  .route-list {
    text-align: left;
    max-width: 500px;
    margin: 0 auto;
  }

  .route-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1rem 0.5rem;
    border-bottom: 1px solid var(--hairline-soft);
    transition: background 0.15s;
  }

  a.route-item:hover {
    background: rgba(242, 238, 227, 0.04);
  }

  .route-item:last-child {
    border-bottom: none;
  }

  .route-name {
    color: var(--ink);
    font-size: 1.1rem;
  }

  .route-status {
    font-variant: small-caps;
    letter-spacing: 2px;
    font-size: 0.85rem;
    color: var(--uj-red);
  }

  @media (max-width: 760px) {
    .page-title { font-size: 2.4rem; }
    .nav-tabs { gap: 1.4rem; }
    .cal-frame { padding: 0.75rem; }
    .cal-grid { gap: 3px; }
    .cal-cell { min-height: 54px; padding: 0.25rem; }
    .cal-title, .cal-mission { display: none; }
    .cal-icon { font-size: 0.9rem; }
    .england-prose { font-size: 1.05rem; }
    .england-prose table { display: block; overflow-x: auto; }
  }
</style>

<script>
  function showTab(tabId) {
    document.querySelectorAll('.tab-content').forEach(tab => {
      tab.classList.remove('active');
    });
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.tab === tabId);
    });
    document.getElementById(tabId).classList.add('active');
  }

  function jumpToDay(n) {
    showTab('itinerary');
    const target = document.getElementById('day-' + n);
    if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  document.addEventListener('DOMContentLoaded', () => {
    // Tag each "Day N" heading in the rendered brief so calendar cells can link to it.
    document.querySelectorAll('#itinerary h2').forEach((h, i) => {
      h.id = 'day-' + (i + 1);
    });

    // Persistent checklist state
    const checklist = document.getElementById('checklist');
    const STORAGE_KEY = 'england_checklist_state';

    function initChecklist() {
      const checkboxes = checklist.querySelectorAll('input[type="checkbox"]');
      if (checkboxes.length === 0) return;

      // Key saved state by section + item text, not index, so list edits don't
      // shift ticks and duplicate items ("Inner tube" x2) don't collide.
      const keyFor = (cb) => {
        const li = cb.closest('li');
        const section = li?.closest('ul')?.previousElementSibling?.textContent?.trim().slice(0, 40) || '';
        return section + '::' + (li?.textContent || '').trim().slice(0, 80);
      };
      const savedState = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
      checkboxes.forEach((cb) => {
        if (savedState[keyFor(cb)]) {
          cb.checked = true;
        }

        cb.addEventListener('change', () => {
          const currentState = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
          currentState[keyFor(cb)] = cb.checked;
          localStorage.setItem(STORAGE_KEY, JSON.stringify(currentState));
        });

        // Whole row toggles — the checkbox alone is a fiddly tap target on phones.
        cb.closest('li')?.addEventListener('click', (e) => {
          if (e.target === cb) return;
          cb.checked = !cb.checked;
          cb.dispatchEvent(new Event('change'));
        });
      });
    }

    initChecklist();
  });
</script>
