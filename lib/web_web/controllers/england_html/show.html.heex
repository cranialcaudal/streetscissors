<%!-- The England trip, `/england2026` (unlisted): itinerary, calendar and packing checklist.
      Rendered by `WebWeb.EnglandController.show/2`; the trip's facts come from `content/england2026/`. --%>
<div class="england-container">
  <header class="england-header">
    <div class="title-row">
      <h1 class="page-title">{@trip["title"]}</h1>
    </div>
    <p :if={@trip["subtitle"] != ""} class="mission-sub">{@trip["subtitle"]}</p>
    <div class="abbey-crossing" aria-hidden="true"></div>

    <div class="nav-tabs" role="tablist">
      <button
        type="button"
        class="tab-btn active"
        data-tab="calendar"
        role="tab"
        aria-selected="true"
      >
        Calendar
      </button>
      <button type="button" class="tab-btn" data-tab="itinerary" role="tab" aria-selected="false">
        Itinerary
      </button>
      <button type="button" class="tab-btn" data-tab="checklist" role="tab" aria-selected="false">
        Packing
      </button>
      <button type="button" class="tab-btn" data-tab="routes" role="tab" aria-selected="false">
        Routes
      </button>
    </div>
  </header>

  <div id="calendar" class="tab-content active">
    <div class="cal-frame">
      <div class="cal-month">{Calendar.strftime(@calendar_month, "%B %Y")}</div>
      <div class="cal-grid">
        <div :for={dow <- ~w(Sun Mon Tue Wed Thu Fri Sat)} class="cal-dow">{dow}</div>
        <%= for week <- @calendar_weeks, day <- week do %>
          <%= if day && @trip_days[day] do %>
            <button type="button" class="cal-cell trip" data-jump-day={@trip_days[day].num}>
              <span class="cal-head">
                <span class="cal-date">{day}</span>
                <span class="cal-mission">Day {@trip_days[day].num}</span>
              </span>
              <span class="cal-icon">{@trip_days[day].icon}</span>
              <span class="cal-title">{@trip_days[day].title}</span>
            </button>
          <% else %>
            <div class={["cal-cell", if(day, do: "off", else: "blank")]}>
              <span :if={day} class="cal-date">{day}</span>
            </div>
          <% end %>
        <% end %>
      </div>
      <div class="cal-legend">
        <span class="legend-chip"></span> trip day &mdash; tap one for the day's plan
      </div>
    </div>

    <a :if={@trip["call_link"]} href="/england2026/call" class="call-page-btn">
      {@trip["call_link"]}
    </a>
  </div>

  <div id="itinerary" class="tab-content">
    <div class="england-prose">
      {raw(@itinerary)}
    </div>
  </div>

  <div id="checklist" class="tab-content">
    <div class="england-prose">
      {raw(@checklist)}
    </div>
  </div>

  <div id="routes" class="tab-content">
    <div class="komoot-placeholder">
      <h3>Routes</h3>
      <p>
        Rides are synced from Komoot and archived on the <a
          href="/fitness/rides"
          class="routes-link"
        >Activities page</a>.
      </p>

      <div :if={@trip["routes"] != []} class="route-list">
        <a :for={route <- @trip["routes"]} href="/fitness/rides" class="route-item">
          <span class="route-name">{route["name"]}</span>
          <span class="route-status">{route["status"]}</span>
        </a>
      </div>
    </div>
  </div>
</div>
