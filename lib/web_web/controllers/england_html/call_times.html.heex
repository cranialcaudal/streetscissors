<%!-- When to call home during the England trip, `/england2026/call` (unlisted). Rendered by
      `WebWeb.EnglandController.call_times/2`; the people and times come from `content/england2026/`. --%>
<div class="call-container">
  <header class="call-header">
    <h1 class="call-title">{@call["title"]}</h1>
    <p :if={@call["subtitle"] != ""} class="call-sub">{@call["subtitle"]}</p>
    <div class="abbey-crossing" aria-hidden="true"></div>
  </header>

  <div
    id="call-now"
    class="now-banner neutral"
    data-home-tz={@call["home_tz"]}
    data-away-tz={@call["away_tz"]}
    data-window-start={@call["window_start"]}
    data-window-end={@call["window_end"]}
    data-good={@call["good_now"]}
    data-wait={@call["wait"]}
  >
    Checking the clocks&hellip;
  </div>

  <div class="clocks">
    <div class="clock">
      <div class="clock-label">{@call["home_label"]}</div>
      <div class="clock-time" id="clock-ca">&mdash;</div>
    </div>
    <div class="clock">
      <div class="clock-label">{@call["away_label"]}</div>
      <div class="clock-time" id="clock-uk">&mdash;</div>
    </div>
  </div>

  <div :if={@call_html != ""} class="golden-rule">{raw(@call_html)}</div>

  <div class="back-row">
    <a href="/england2026" class="back-link">&larr; Back to the trip page</a>
  </div>
</div>
