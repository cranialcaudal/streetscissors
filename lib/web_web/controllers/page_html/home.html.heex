<%!-- The homepage, `/`: the wordmark over a contact sheet, the cards for each section, and the
      "Happening" strip. Rendered by `WebWeb.PageController.home/2`. --%>
<div class="home-wrapper">
  <%!-- Top Bar: Guestbook (left) | Spotify (center) | Newsletter (right) --%>
  <nav class="home-top-bar">
    <div class="desktop-top-bar-contents">
      <%!-- No inline style here: a `border: none` on these two outranked every
            stylesheet rule, which is why they rendered as loose words beside
            the framed playlist pill. Their frame lives in home.css. --%>
      <a href={~p"/guestbook"} class="top-bar-link" aria-label="Guestbook">
        <.icon name="hero-book-open" class="size-4 top-bar-icon" />
        <span class="top-bar-text">Guestbook</span>
      </a>

      <div class="top-bar-center">
        <div class="spotify-hover-wrapper">
          <%!-- Focusable so the player opens from the keyboard too: the
                dropdown shows on :focus-within as well as :hover, and stays
                open while focus moves on into the player. --%>
          <div class="spotify-pill-main" tabindex="0">
            <svg
              class="spotify-icon"
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.5 17.3c-.2.3-.6.4-.9.2-2.5-1.5-5.6-1.9-9.3-1-.4.1-.7-.2-.8-.5-.1-.4.2-.7.5-.8 4.1-1 7.6-.5 10.3 1.2.3.2.4.6.2.9zm1.5-3.3c-.3.4-.8.5-1.2.3-3-1.8-7.5-2.4-11-1.3-.4.1-.9-.1-1-.5-.1-.4.1-.9.5-1 4.1-1.2 9.1-.6 12.5 1.5.4.1.5.7.2 1zm.1-3.4C15.5 8.4 9 8.2 5.2 9.3c-.6.2-1.2-.2-1.3-.7-.2-.6.2-1.2.7-1.3 4.4-1.3 11.5-1.1 16 1.6.5.3.7 1 .4 1.5-.3.5-1 .7-1.5.4z" />
            </svg>
            <span>Latest Playlist</span>
          </div>
          <div class="spotify-player-dropdown">
            <iframe
              src={"https://open.spotify.com/embed/playlist/#{@spotify_playlist_id}?utm_source=generator&theme=0"}
              width="100%"
              height="152"
              frameBorder="0"
              allowfullscreen=""
              allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              loading="lazy"
              style="border-radius: 12px; box-shadow: 0 8px 32px 0 rgba(0,0,0,0.6);"
            >
            </iframe>
          </div>
        </div>

        <a
          :if={@spotify_profile}
          href={@spotify_profile}
          target="_blank"
          class="spotify-pill-profile"
          title="Spotify Profile"
        >
          <%!-- A mark in the top bar: the 96-pixel copy, not the photograph. --%>
          <img
            src={~p"/images/spotify_profile-96.jpg"}
            alt="Spotify Profile"
            width="96"
            height="96"
          />
        </a>

        <%!-- Search. On a wide screen it is one more square mark; on a phone
              it is the bar itself: a field-shaped control that takes the
              width the three marks leave (home.css), because a fourth
              square in a row of squares read as clutter. Its word is
              shown only there. --%>
        <a href={~p"/search"} class="top-bar-link top-bar-link--search" aria-label="Search">
          <.icon name="hero-magnifying-glass" class="size-4 top-bar-icon" />
          <span class="top-bar-search-word" aria-hidden="true">Search</span>
        </a>
      </div>

      <button
        type="button"
        data-dispatch
        class="top-bar-link"
        aria-label="Newsletter and Contact"
      >
        <span class="top-bar-text">Newsletter and Contact</span>
        <.icon name="hero-envelope" class="size-4 top-bar-icon" />
      </button>
    </div>
  </nav>

  <%!-- Bento Section: Blog + Fitness boxes with overlapping title, photo hero below --%>
  <section class="bento-section">
    <div class="site-title-container">
      <div class="site-title-wrap">
        <h1 class="site-title-overlay" aria-label="streetscissors">
          <WebWeb.CoreComponents.wordmark />
        </h1>
      </div>
    </div>

    <div class="bento-row">
      <a href={~p"/blog"} class="bento-card bento-card-blog">
        <span class="bento-label">[Blog]</span>
      </a>
      <a href={~p"/fitness"} class="bento-card bento-card-blog">
        <span class="bento-label bento-label-stacked">
          <span>Fitness</span>
          <span>&amp;</span>
          <span>Sport</span>
        </span>
      </a>
    </div>

    <%!-- Full-width photo hero: a random contact sheet behind the label --%>
    <a href={~p"/negatives?from=home"} class="bento-card bento-card-hero">
      <%= if @hero_sheet do %>
        <%!-- The largest thing on the first screen, so it is asked for
              first and at the size it is drawn: the full preview was 410 KB
              here, and it was marked lazy. --%>
        <img
          class="bento-hero-image"
          src={Web.Negatives.sized_url(@hero_sheet.preview_url, 960)}
          srcset={"#{Web.Negatives.sized_url(@hero_sheet.preview_url, 480)} 480w, #{Web.Negatives.sized_url(@hero_sheet.preview_url, 960)} 960w"}
          sizes="(max-width: 550px) 100vw, 960px"
          alt=""
          fetchpriority="high"
          decoding="async"
        />
      <% end %>
      <div class="bento-hero-scrim"></div>
      <%!-- Geometry is measured off the rendered font, never guessed — see
            WebWeb.CoreComponents.baker_wordmark/1. --%>
      <WebWeb.CoreComponents.baker_wordmark
        class="bento-hero-wordmark"
        viewbox="3.84 31.52 993.34 66.96"
        label="Contact Sheets/Photos"
        lines={[%{text: "Contact Sheets/Photos", x: "0", y: "100", length: "1000"}]}
      />
      <%!-- Phones: 21 glyphs stretched across ~340px collapses into a picket
            fence of vertical strokes, so narrow screens get two lines instead. --%>
      <WebWeb.CoreComponents.baker_wordmark
        class="bento-hero-wordmark bento-hero-wordmark--stacked"
        viewbox="0 34.6 1000 148.8"
        label="Contact Sheets/Photos"
        lines={[
          %{text: "Contact Sheets", x: "-5.95", y: "100", length: "1010.32"},
          %{text: "Photos", x: "-17.61", y: "188", length: "1027.29"}
        ]}
      />
    </a>

    <%!-- Fitness Sub-row: Three skinny boxes --%>
    <div class="bento-fitness-sub-row bento-fitness-sub-row--three">
      <a href={~p"/logs?from=home"} class="bento-card bento-card-skinny">
        <span class="bento-label-small">Captain's Logs</span>
      </a>
      <a href={~p"/about?from=home"} class="bento-card bento-card-skinny">
        <span class="bento-label-small">About Me</span>
      </a>
      <a href={~p"/Christ"} class="bento-card bento-card-skinny">
        <span class="bento-label-small">Christ</span>
      </a>
    </div>
    <%!-- Happening (Web.Happening): what is going on, what is new, and what
          people looked at this week. Dates only, never a clock time; on the
          locked phone layout only the Now line shows (home.css). --%>
    <section
      :if={@happening.now.block || @happening.now.ride || @happening.fresh != []}
      class="home-happening"
      aria-label="Happening"
    >
      <div class="home-happening-col home-happening-now">
        <h2 class="home-happening-head">Now</h2>
        <p :if={@happening.now.block} class="home-happening-line">
          <a href={~p"/fitness"}>{@happening.now.block}</a>
        </p>
        <p :if={@happening.now.ride} class="home-happening-line">
          <a href={@happening.now.ride.path}>
            {@happening.now.ride.sport}, {@happening.now.ride.distance}
          </a>
          <span class="home-happening-date">
            {Calendar.strftime(@happening.now.ride.date, "%-d %b")}
          </span>
        </p>
        <p :if={@happening.now.reading} class="home-happening-line">
          Reading {@happening.now.reading}
        </p>
      </div>
      <div :if={@happening.fresh != []} class="home-happening-col home-happening-fresh">
        <h2 class="home-happening-head">Fresh</h2>
        <p :for={item <- @happening.fresh} class="home-happening-line">
          <span class="home-happening-kind">{item.kind}</span>
          <a href={item.path}>{item.title}</a>
          <span :if={item.date} class="home-happening-date">
            {Calendar.strftime(item.date, "%-d %b")}
          </span>
        </p>
      </div>
      <div :if={@happening.witnessed != []} class="home-happening-col home-happening-witnessed">
        <h2 class="home-happening-head">Witnessed this week</h2>
        <p :for={item <- @happening.witnessed} class="home-happening-line">
          <span class="home-happening-kind">{item.kind}</span>
          <a href={item.path}>{item.title}</a>
          <span class="home-happening-date">
            {item.people} {if item.people == 1, do: "person", else: "people"}
          </span>
        </p>
      </div>
    </section>
    <%!-- One sentence saying what the site is, when the author has written
          one (Settings: "Homepage sentence"). Nothing when he has not. --%>
    <p :if={@site_description} class="home-about">{@site_description}</p>
    <%!-- New: the newest post, video and roll, in a card that slides into the
          corner a moment after the page loads (assets/js/home_new.js), over
          the tiles rather than among them. Closed, it stays closed until
          something newer arrives. Rendered hidden: without JavaScript the
          page is the tiles alone. The video plays a few silent seconds on
          hover (assets/js/home_previews.js); nothing loads before that. --%>
    <aside
      :if={@lately.posts != [] || @lately.log || @lately.roll}
      id="home-new"
      class="home-new"
      aria-labelledby="home-new-title"
      data-new={@new_key}
      hidden
    >
      <header class="home-new-head">
        <h2 id="home-new-title" class="home-new-title">New</h2>
        <button type="button" class="home-new-close" data-new-close aria-label="Close">
          <span aria-hidden="true">×</span>
        </button>
      </header>

      <a
        :if={@lately.log}
        href={@lately.log.path}
        class="new-item"
        data-preview={@lately.log.video}
      >
        <span class="new-plate new-plate--video">
          <img
            :if={@lately.log.poster}
            src={@lately.log.poster}
            alt=""
            loading="lazy"
            decoding="async"
          />
          <svg class="new-play" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="11" />
            <path d="M10 8l6 4-6 4z" />
          </svg>
        </span>
        <span class="new-text">
          <span class="new-kind">Captain's log</span>
          <span class="new-name">{@lately.log.title}</span>
          <span :if={@lately.log.duration} class="new-meta">
            {WebWeb.LogsLive.Format.format_duration(@lately.log.duration)}
          </span>
        </span>
      </a>

      <a :for={post <- Enum.take(@lately.posts, 1)} href={post.path} class="new-item">
        <span class={["new-plate", !post.cover && "new-plate--type"]}>
          <img
            :if={post.cover}
            src={post.cover.url}
            srcset={post.cover.srcset}
            sizes="7rem"
            alt=""
            loading="lazy"
            decoding="async"
          />
          <span :if={!post.cover} aria-hidden="true">{String.first(post.title)}</span>
        </span>
        <span class="new-text">
          <span class="new-kind">Writing</span>
          <span class="new-name">{post.title}</span>
          <span class="new-meta">
            {Calendar.strftime(post.date, "%-d %b")} · {post.read_min} min
          </span>
        </span>
      </a>

      <a :if={@lately.roll} href={@lately.roll.path} class="new-item">
        <span class="new-plate">
          <img
            src={Web.Negatives.sized_url(@lately.roll.preview_url, 480)}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </span>
        <span class="new-text">
          <span class="new-kind">Negatives</span>
          <span class="new-name">Roll {@lately.roll.roll}</span>
          <span class="new-meta">
            {Calendar.strftime(@lately.roll.date, "%-d %b")}<span :if={@lately.roll.count > 0}> · {@lately.roll.count} prints</span>
          </span>
        </span>
      </a>
    </aside>
    <footer class="home-footer">
      &copy; {Web.Clock.local_today().year}
      <span :if={@author}>{@author} &middot;</span>
      streetscissors. <a href={~p"/daybook"} class="home-footer-link">The daybook</a>
      <a href={~p"/how-to?from=home"} class="home-footer-link">How this is made</a>
      <WebWeb.Microformats.representative_card />
      <a
        href={~p"/admin/login"}
        title="Admin Dashboard"
        style="opacity: 0.4; margin-left: 0.5rem; font-size: 1.2rem; text-decoration: none; transition: opacity 0.2s;"
        onmouseover="this.style.opacity='1'"
        onmouseout="this.style.opacity='0.4'"
      >
        ☧
      </a>
    </footer>
  </section>
</div>
