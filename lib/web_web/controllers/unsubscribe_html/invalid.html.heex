<%!-- An unsubscribe link whose token matches no subscriber. Rendered by
      `WebWeb.UnsubscribeController` (`show/2` and `update/2`). --%>
<div class="unsub-wrapper">
  <div class="unsub-panel">
    <h1 class="unsub-title">That link didn't work</h1>

    <p class="unsub-body">
      This unsubscribe link is malformed or incomplete — most often because a mail
      client wrapped it across two lines and only part of it came through.
    </p>

    <p class="unsub-aside">
      Try copying the whole link out of the email<%= if email = Application.get_env(:web, :contact_email) do %>, or write to
        <a href={"mailto:#{email}"}>{email}</a>
        and you'll be taken off by hand<% end %>.
    </p>
  </div>
</div>
