<div class="unsub-wrapper">
  <div class="unsub-panel">
    <h1 class="unsub-title">Unsubscribed</h1>

    <p class="unsub-body">
      <strong>{@email}</strong> has been removed from the dispatch. Nothing further
      will be sent.
    </p>

    <p class="unsub-aside">
      No hard feelings. The writing is all still at <.link navigate={~p"/blog"}>the blog</.link>, and the feed is at
      <a href={~p"/feed"}>/feed</a>
      if you'd rather read it without email.
    </p>

    <p class="unsub-aside">
      Subscribed by mistake, or want back on later? <.link navigate={~p"/newsletter"}>Sign up again</.link>.
    </p>
  </div>
</div>
