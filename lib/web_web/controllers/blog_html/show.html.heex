<div class="blog-bento-wrapper writing">
  <article class="blog-post-panel h-entry">
    <WebWeb.Microformats.entry_fields path={~p"/blog/#{@post.slug}"} />
    <header class="blog-post-header">
      <p :if={@post.draft} class="blog-post-draft" role="status">
        Draft. Only you can see this page.
        <a href={~p"/admin/blog/#{@post.slug}/edit"}>Edit it</a>
      </p>
      <.post_meta post={@post} />
      <h1 class="blog-post-title p-name">{@post.title}</h1>
    </header>

    <div class="blog-post-content prose e-content">
      {raw(@post.html)}
    </div>

    <footer :if={@post.keywords != []} class="blog-post-keywords">
      <span class="writing-control-label">Filed under:</span>
      <.keyword_links keywords={@post.keywords} variant={:chips} />
    </footer>

    <%!-- Shown only in print (writing.css): a sheet of paper has no address bar. --%>
    <p class="blog-post-colophon">
      streetscissors · {WebWeb.SEO.absolute(~p"/blog/#{@post.slug}")}
    </p>
  </article>

  <%!-- Letters about this post, and the sites that cite it (WebWeb.LettersLive).
        Not under a draft: there is nothing public yet to write about. --%>
  <%= if !@post.draft do %>
    {live_render(@conn, WebWeb.LettersLive,
      id: "letters-post",
      session: %{
        "piece" => Web.Pieces.post(@post.slug),
        "remote_ip" => WebWeb.ClientIP.from_conn(@conn)
      }
    )}
  <% end %>
</div>
