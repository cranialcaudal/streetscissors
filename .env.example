# Production Environment Variables
# Keep this file SECURE. Do not commit to git.

SECRET_KEY_BASE=generate_with_mix_phx_gen_secret
PHX_HOST=localhost
# NOTE: DATABASE_PATH is deliberately NOT set here. The systemd unit and
# start_prod.sh export it after sourcing this file, so a value here would be
# a second source of truth that silently loses. Only secrets belong in .env.
PORT=4000
RESEND_API_KEY=your_resend_api_key
ADMIN_PASSWORD=your_admin_password
# Optional — Komoot auto-sync for /fitness/rides (sync stays off when unset)
KOMOOT_EMAIL=your_komoot_account_email
KOMOOT_PASSWORD=your_komoot_account_password
# Optional — Health Auto Export webhook (endpoint returns 401 when unset)
HEALTH_WEBHOOK_TOKEN=generate_with_openssl_rand_hex_32
# Optional — off-disk copy of database snapshots (skipped when the path is absent)
BACKUP_MIRROR_PATH=/mnt/external/streetscissors-backups/db
