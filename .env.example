# Production Environment Variables
# Keep this file SECURE. Do not commit to git.

SECRET_KEY_BASE=generate_with_mix_phx_gen_secret
PHX_HOST=localhost
# NOTE: DATABASE_PATH is deliberately NOT set here. The systemd unit and
# start_prod.sh export it after sourcing this file, so a value here would be
# a second source of truth that silently loses. Only secrets belong in .env.
PORT=4000
RESEND_API_KEY=your_resend_api_key
ADMIN_PASSWORD=your_admin_password
# Optional — Komoot auto-sync for /fitness/rides (sync stays off when unset)
KOMOOT_EMAIL=your_komoot_account_email
KOMOOT_PASSWORD=your_komoot_account_password
# Optional — bearer token for the Apple Health webhook, POST /api/health/ingest.
# One can also be made on the admin's Activities page. Unset and unmade, the
# endpoint refuses everything.
HEALTH_WEBHOOK_TOKEN=
# Optional — off-disk copy of database snapshots (skipped when the path is absent)
BACKUP_MIRROR_PATH=/mnt/external/streetscissors-backups/db
# Optional — off-disk copies of the written content's versions and of the
# captain's logs' media. Each folder is made on first use, inside a folder that
# is already there; an unplugged drive is skipped.
CONTENT_MIRROR_PATH=/mnt/external/streetscissors-backups/content
UPLOADS_MIRROR_PATH=/mnt/external/streetscissors-backups/uploads
# Optional — where the site writes to its author (a held signature, a fault on
# the machine) when no address is set in the admin's settings
NOTIFY_EMAIL=
# Optional — systemd user units the monitor expects to be active, comma-separated
MONITOR_UNITS=caddy.service
# Optional — the negatives archive (defaults to ./negatives beside the checkout)
NEGATIVES_PATH="/path/to/Negatives"
# Optional — the author named in the site's structured data (omitted when unset)
AUTHOR_NAME="Your Name"
# Optional — what the /pc terminal calls itself (defaults to "The Machine")
MACHINE_NAME="Your Machine"

# The places no activity may be shown near: lat,lng (several separated by ;).
# Komoot's own privacy zones do the hiding. This is the site's note of what
# they are meant to hide: each tour is checked as a stranger sees it, and one
# that still shows such a place loses its map. Unset, nothing is checked.
RIDE_PRIVACY_ZONES=

# Film scanner (admin → Scanner). Where one strip sits in the holder, in mm
# from the top-left of the transparency area: left,top,width,height.
# SCANNER_DEVICE pins a SANE backend by id prefix when several are attached.
SCANNER_AREA_35MM=
SCANNER_AREA_120=
SCANNER_DEVICE=
