#!/usr/bin/env bash
# Stands in for ffmpeg during the test suite: writes output files of the right
# shape in the right places, instantly, and emits the same -progress lines the
# real thing does so the transcoder's parsing is exercised for real.
#
# STUB_FFMPEG_FAIL=1 makes it fail the way a bad source would.
set -u

if [ "${STUB_FFMPEG_FAIL:-}" = "1" ]; then
  echo "stub: Invalid data found when processing input" >&2
  exit 1
fi

args=("$@")
output="${args[${#args[@]}-1]}"

# -progress pipe:1 is what the transcoder parses; emit a couple of ticks.
progress=0
for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[$i]}" in
    -progress) progress=1 ;;
  esac
done

if [ "$progress" = "1" ]; then
  echo "out_time_us=1000000"
  echo "progress=continue"
  echo "out_time_us=12000000"
  echo "progress=end"
fi

# Every output this stub is asked for — video.mp4, audio.m4a, a poster, a
# waveform — is a single file; write it where it was asked for.
mkdir -p "$(dirname "$output")"
printf 'stub-media' > "$output"
