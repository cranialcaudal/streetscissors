#!/usr/bin/env bash
# Stands in for ImageMagick so the suite does not need it installed.
#
# Web.Negatives shells out to `magick <input> -resize ... <output>` to make the
# downscaled previews it serves. The real thing is only ever asked to shrink an
# image, and nothing in the suite decodes the result, so copying the input is a
# faithful enough answer: the output exists, at the output's path, and is a
# real file of the shape the caller expects.
#
# STUB_MAGICK_FAIL=1 fails instead, which is how the fall-back-to-the-original
# branch gets exercised.
set -euo pipefail

if [ "${STUB_MAGICK_FAIL:-0}" = "1" ]; then
  echo "stub magick: refusing to convert" >&2
  exit 1
fi

if command -v magick >/dev/null 2>&1; then
  exec magick "$@"
fi

# A path may carry its format in front (`tiff:/path`), as the scanner's
# resample step writes it.
input="${1#tiff:}"
for last; do :; done
output="${last#tiff:}"

mkdir -p "$(dirname "$output")"
if [ "$input" = "$output" ]; then
  :
elif [ -f "$input" ]; then
  cp "$input" "$output"
else
  touch "$output"
fi
