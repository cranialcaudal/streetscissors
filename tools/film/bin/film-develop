#!/usr/bin/env python3
"""film-develop — the image analysis behind the film pipeline.

Everything that measures or renders negative scans lives here, so there is
exactly one copy of the part that is easy to get wrong: deciding which pixels
are film. The scanner bed sits at 255 and the holder gaps at 0, so every
channel of a raw strip already spans the full range and any plain auto-levels
is a no-op. Excluding those non-film pixels first is what makes every
measurement below mean anything.

Subcommands:

  strips DEST --mode color|bw SCAN...
      Turn strip scans into positives. Used by digital-contact-sheet-maker,
      which then composites them with GIMP's own invert switched off.

  analyze ROLLDIR [--frames-per-strip N] [--export DIR]
      Split each strip into frames, read each frame's exposure, and derive
      per-strip development settings as a quality-weighted mean of its frames.
      Writes frames.json in the roll folder.

  develop RAW --roll ROLLDIR --frame N [--weight W]
      Develop one high-resolution single-frame scan, blending the frame's own
      reading with its strip's settings (default 70% strip / 30% frame).

How a negative is developed (revised 2026-10-07, when single frames became
part of the pipeline and per-frame colour stopped being good enough):

  The roll sets the colour; the frame sets only its exposure.

  A roll is one emulsion through one developer, so its colour is one thing:
  the film base (what the rebate between frames reads), the density range its
  well exposed frames reach, and where the three channels' midtones sit, all
  pooled over the whole roll. That is the "film" block in frames.json, and
  every frame on the roll is converted with it. Judging colour frame by
  frame was the old way, and it is what tinted thin negatives blue: with
  little on the film there is no colour to measure, only noise to stretch.

  What does differ between frames is exposure, and that is corrected with
  neutral moves only (one black point, one white point, one gamma for all
  three channels), each held within limits, so a thin frame comes out dark
  and honest, never purple. A frame may also lean a little towards its own
  colour reading, in proportion to how much picture it holds.

  color  C-41 carries an orange base mask, so a straight invert washes every
         frame blue. Each channel is normalised between the film base and
         the roll's densest highlight, inverted, and the three midtones are
         pulled together.
  bw     No mask. One range shared by all three channels (never per-channel:
         that would tint a monochrome image) and the channels averaged into
         true neutral grey, which also cancels the scanner's slight channel
         imbalance.

Where the frames are:

  35mm frames sit 38.00 mm apart whatever the camera, so on a 35mm strip the
  only thing to find is where that grid starts, and the count is simply how
  many fit on the film. (Cutting every strip into six, as before, cut through
  pictures on any strip that held five, or three and a leader.) 120 and 620
  spacing belongs to the camera, so there the count is still given per roll
  and each cut is fitted to the rebate. Either way a frame's rectangle is the
  picture itself: the rebate either side and the film's edges are left out.
"""

import argparse
import glob
import json
import math
import os
import subprocess
import sys

WHITE, BLACK = 245, 12   # non-film: scanner bed / clear area, holder gap
CLIP = 0.5               # percent of film pixels discarded at each end
ANALYSIS_SCALE = 25      # percentiles are stable well below full resolution

SCAN_EXTS = ("jpg", "jpeg", "png", "tif", "tiff", "bmp", "webp")

# Interquartile spread of a healthy negative. Measured on real rolls: good
# frames sit around 50, and a blown or empty one falls well under 25. The
# clipped endpoints are no use for this — outliers pin them at nearly the full
# range even on a frame with no tone in it at all.
HEALTHY_CONTRAST = 55.0
WELL_EXPOSED = 0.5       # quality score at or above which a frame counts

FRAMES_PER_STRIP = {"35mm": 6, "120": 3, "620": 3}

# How far either side of its fitted position a boundary may move to sit on the
# rebate, as a fraction of one frame's pitch.
REFINE_WINDOW = 0.20
# A rebate band has to be this much brighter than its neighbourhood to count
# as a real find rather than noise.
REBATE_LIFT = 1.02
# How far above a strip's own boundary brightness an interior band has to sit
# before the split is called wrong. Deliberately conservative: at this value
# no correctly-split roll in the collection trips it, while a 620 roll split
# 3-per-strip instead of 2 scores over 8.
SPLIT_WARN_LIFT = 1.5
# Frame stats ignore this much of each edge, so the rebate never enters them.
STATS_INSET = 0.05
STATS_SIDE = 0.08

STRIP_DPI = 300.0        # strips are archived at this, whatever they were scanned at

# 35mm: eight perforations a frame, 4.75 mm each. The picture is 36 mm of it.
PITCH_35MM = 38.0
GAP_35MM = 2.0
# A cell of the grid has to be this much on the film to be a frame; less is
# the stub left where a strip was cut.
MIN_CELL = 0.85
# Kept clear of the rebate at each end of a frame, and of the film's edges
# across it (as a fraction of the strip's width).
EDGE_CLEAR_MM = 0.3
SIDE_INSET = 0.02


# Limits on what a frame may do to itself. The white point may bring a thin
# frame up, but not by more than this. The black point may come most of the
# way up to the frame's own darkest tone, which is what prints a dense
# (overexposed) negative down instead of leaving it a white sheet. The
# midtone is moved part of the way to the middle, within bounds.
WHITE_FLOOR = 0.42
BLACK_CEILING = 0.85
BLACK_STRENGTH = 0.9
MID_TARGET = 0.42
MID_STRENGTH = 0.6
GAMMA_LIMITS = (0.72, 1.5)
# How far a frame may lean to its own colour reading, at full quality.
COLOUR_LEAN = 0.5

# The film base is the brightest film on a strip: the rebate, a few percent
# of it. A little under the very top keeps the blur at the film's edge out.
BASE_PCT = 98.0
# Where up the density scale the three layers' rates are compared, and where
# the roll's dense end is taken to be white.
RATE_POINTS = (40, 55, 70, 82, 92)
DENSE_PCT = 99.0
# Bounds on the roll's contrast.
POWER_LIMITS = (0.6, 3.2)

# Dust on the film blocks the lamp, so it scans dark and prints as white
# specks. A speck is far brighter than its surroundings and small.
DUST_MEDIAN = 7
DUST_LIFT = 14           # percent brighter than the local median
DUST_MAX_RADIUS = 3.5    # px; anything an opening this size keeps is picture


# --- reading ------------------------------------------------------------

def _magick(args):
    return subprocess.run(["magick"] + args, capture_output=True, check=True).stdout


def _crop_args(crop):
    if not crop:
        return []
    x, y, w, h = crop
    return ["-crop", f"{w}x{h}+{x}+{y}", "+repage"]


def read_rgb(path, crop=None, scale=ANALYSIS_SCALE):
    return _magick([path] + _crop_args(crop) +
                   ["-resize", f"{scale}%", "-depth", "8", "rgb:-"])


def read_grey(path, crop=None, scale=ANALYSIS_SCALE):
    return _magick([path] + _crop_args(crop) +
                   ["-resize", f"{scale}%", "-grayscale", "Average",
                    "-depth", "8", "gray:-"])


def dimensions(path):
    out = _magick([path, "-format", "%w %h", "info:"]).decode()
    w, h = out.split()
    return int(w), int(h)


def film_pixels(rgb):
    """Yields (byte offset, r, g, b) for pixels that are film, not bed or gap."""
    for i in range(0, len(rgb) - 2, 3):
        r, g, b = rgb[i], rgb[i + 1], rgb[i + 2]
        if (r >= WHITE and g >= WHITE and b >= WHITE) or \
           (r <= BLACK and g <= BLACK and b <= BLACK):
            continue
        yield i, r, g, b


def percentiles(hist, kept):
    def pct(q):
        target, c = kept * q / 100.0, 0
        for v in range(256):
            c += hist[v]
            if c >= target:
                return v
        return 255
    lo, hi, mid = pct(CLIP), pct(100 - CLIP), pct(50)
    return (0, 255, mid) if hi <= lo else (lo, hi, mid)


# --- settings -----------------------------------------------------------
#
# A "settings" dict is the development recipe for one image: per-channel black
# point, white point and gamma. Colour carries three channels, B&W one. This is
# the form that gets persisted, blended and turned into ImageMagick arguments.

def interquartile(hist, kept):
    """p75 - p25 of a histogram: how much tone the image actually carries."""
    def pct(q):
        target, c = kept * q / 100.0, 0
        for v in range(256):
            c += hist[v]
            if c >= target:
                return v
        return 255
    return pct(75) - pct(25)


def histograms(path, crop=None):
    """Per-channel and grey histograms of an image's film pixels:
    ([r, g, b] histograms, grey histogram, pixels kept)."""
    rgb = read_rgb(path, crop)
    grey = read_grey(path, crop)
    hist, ghist, kept = [[0] * 256 for _ in range(3)], [0] * 256, 0
    for i, r, g, b in film_pixels(rgb):
        hist[0][r] += 1; hist[1][g] += 1; hist[2][b] += 1
        ghist[grey[i // 3]] += 1
        kept += 1
    return hist, ghist, kept


def add_hist(total, more):
    for v in range(256):
        total[v] += more[v]


def pct(hist, kept, q):
    target, c = kept * q / 100.0, 0
    for v in range(256):
        c += hist[v]
        if c >= target:
            return v
    return 255


def density(value, base):
    """Optical density above the film base: 0 where the film is clear."""
    return max(0.0, -math.log10(max(value, 0.5) / float(max(base, 1))))


def print_value(d, power, white):
    """Where a density lands in the print, 0..1."""
    return min(max((1.0 - 10.0 ** (-power * d)) / white, 0.0), 1.0)


def layer_rates(hist, kept, base):
    """How fast the red and blue layers build density against the green, read
    at several points up the scale and the middle reading taken: [r, 1, b]."""
    def dens(c, q):
        return density(pct(hist[c], kept, 100 - q), base[c])

    rates = []
    for c in range(3):
        ratios = sorted(dens(c, q) / dens(1, q) for q in RATE_POINTS if dens(1, q) > 0.05)
        rates.append(ratios[len(ratios) // 2] if ratios else 1.0)
    return [min(max(r, 0.5), 2.5) for r in rates]


def film_model(mode, frames, strips):
    """The roll's colour, from everything on it.

    frames: [(channel hists, grey hist, kept, quality)] for each frame's
    picture area. strips: the same for each whole strip, rebate included.

    A negative is developed as a print is made: light through the film,
    divided by what comes through bare film, raised to a power and turned
    over.

        print = 1 - (value / base) ^ power        then / white

    * base is the film with nothing on it, the brightest thing a strip holds.
      The middle strip's reading is taken, so one fogged strip cannot move it.
    * The three layers of colour film build density at different rates, which
      is the whole of the orange mask's cast once the base is divided out. The
      rates are read off the roll: at several points up the scale, how dense
      red and blue are against green, pooled over every frame with a picture
      in it. Each channel's power is the roll's contrast over its rate, so a
      grey on the film is a grey in the print at every density, not only at
      the three points a levels-and-gamma fit can pin.
    * The contrast is the one that puts the roll's middle density at a middle
      grey once its dense end is white, within bounds.
    """
    good = [f for f in frames if f[2] and f[3] >= WELL_EXPOSED] or \
           [f for f in frames if f[2]]
    strips = [t for t in strips if t[2]]
    if not good or not strips:
        return None

    def middle(values):
        values = sorted(values)
        return values[len(values) // 2]

    if mode == "color":
        base = [middle([pct(h[c], k, BASE_PCT) for h, _, k, _ in strips]) for c in range(3)]
        pooled, kept = [[0] * 256 for _ in range(3)], 0
        for h, _, k, _ in good:
            for c in range(3):
                add_hist(pooled[c], h[c])
            kept += k

        def dens(c, q):   # the q-th percentile of density is the (100-q)-th of value
            return density(pct(pooled[c], kept, 100 - q), base[c])

        rates = layer_rates(pooled, kept, base)
        mid, top = dens(1, 50), dens(1, DENSE_PCT)
    else:
        base = [middle([pct(g, k, BASE_PCT) for _, g, k, _ in strips])]
        pooled, kept = [0] * 256, 0
        for _, g, k, _ in good:
            add_hist(pooled, g)
            kept += k
        rates = [1.0]
        mid = density(pct(pooled, kept, 50), base[0])
        top = density(pct(pooled, kept, 100 - DENSE_PCT), base[0])

    top = max(top, 0.15)
    mid = min(max(mid, 0.02), top * 0.95)

    # The contrast that puts the middle density at MID_TARGET of the way to
    # white. The ratio rises with the power, from mid/top towards 1.
    def ratio(power):
        return (1.0 - 10.0 ** (-power * mid)) / (1.0 - 10.0 ** (-power * top))

    lo, hi = POWER_LIMITS
    if ratio(lo) >= MID_TARGET:
        power = lo
    elif ratio(hi) <= MID_TARGET:
        power = hi
    else:
        for _ in range(40):
            power = (lo + hi) / 2.0
            lo, hi = (power, hi) if ratio(power) < MID_TARGET else (lo, power)
    white = 1.0 - 10.0 ** (-power * top)

    return {"mode": mode,
            "white": round(white, 4),
            "contrast": round(power, 4),
            "channels": [{"base": b, "power": round(power / r, 4)}
                         for b, r in zip(base, rates)]}


def exposure_for(settings, hist, ghist, kept):
    """The neutral correction a frame gets on top of the roll's colour: one
    black point, one white point, one gamma, the same for every channel."""
    if not kept:
        return {"black": 0.0, "white": settings.get("white", 1.0), "gamma": 1.0}
    # Measured before the roll's white is applied, on the print's own scale
    # (which only reaches 1 at infinite density), so a frame denser than the
    # rest of its roll still has somewhere to go: its white is put where its
    # own highlights are, not clipped at the roll's.
    chans, roll_white = settings["channels"], settings.get("white", 1.0)
    flat = {"black": 0.0, "white": roll_white, "gamma": 1.0}
    if settings["mode"] == "color":
        def lum(q):
            # a negative's dark end is the print's bright end
            return sum(print_value(density(pct(hist[c], kept, 100 - q), chans[c]["base"]),
                                   chans[c]["power"], 1.0) for c in range(3)) / 3.0
    else:
        def lum(q):
            return print_value(density(pct(ghist, kept, 100 - q), chans[0]["base"]),
                               chans[0]["power"], 1.0)

    black = min(max(lum(CLIP), 0.0), BLACK_CEILING) * BLACK_STRENGTH
    top = min(max(lum(100 - CLIP), WHITE_FLOOR * roll_white), 1.0)
    if top - black < 0.04:
        return flat
    mid = min(max((lum(50) - black) / (top - black), 0.02), 0.98)
    full = math.log(mid) / math.log(MID_TARGET)
    gamma = math.exp(MID_STRENGTH * math.log(full))
    gamma = min(max(gamma, GAMMA_LIMITS[0]), GAMMA_LIMITS[1])
    return {"black": round(black, 4), "white": round(top, 4), "gamma": round(gamma, 4)}


def frame_settings(film, hist, ghist, kept, score=0.0):
    """A frame's recipe: the roll's colour, leaned towards the frame's own
    reading of it in proportion to how much picture the frame holds, and the
    frame's own exposure.

    The lean is what lets a frame lit differently from the rest of its roll
    come out neutral; the proportion is what keeps a thin frame, which has
    no colour to read, on the roll's. Nothing leans at all below a third of
    a healthy negative.
    """
    channels = [dict(ch) for ch in film["channels"]]
    lean = COLOUR_LEAN * min(max((score - 0.3) / 0.3, 0.0), 1.0)
    if film["mode"] == "color" and kept and lean > 0 and film.get("contrast"):
        own = layer_rates(hist, kept, [ch["base"] for ch in channels])
        for ch, rate in zip(channels, own):
            ch["power"] = round(_log_mix(ch["power"], film["contrast"] / rate, 1 - lean), 4)
    settings = {"mode": film["mode"], "white": film.get("white", 1.0), "channels": channels}
    settings["exposure"] = exposure_for(settings, hist, ghist, kept)
    return settings


def measure(path, mode, crop=None):
    """An image read on its own, with no roll to go by: its settings, None,
    and the interquartile spread used to judge exposure. Only for scans that
    belong to no analysed roll; the image stands in for the whole of one."""
    hist, ghist, kept = histograms(path, crop)
    if not kept:
        return None, None, 0
    contrast = interquartile(ghist, kept)
    film = film_model(mode, [(hist, ghist, kept, 1.0)], [(hist, ghist, kept, 1.0)])
    return (frame_settings(film, hist, ghist, kept) if film else None), None, contrast


def exposure_args(settings):
    """The frame's black and white on the print's scale, and its gamma. With
    no exposure of its own a frame takes the roll's white."""
    e = settings.get("exposure")
    if not e:
        return ["-level", f"0%,{settings.get('white', 1.0) * 100:.3f}%"]
    args = []
    if e["black"] > 1e-4 or e["white"] < 1 - 1e-4:
        args += ["-level", f"{e['black'] * 100:.3f}%,{e['white'] * 100:.3f}%"]
    if abs(e["gamma"] - 1.0) > 1e-4:
        args += ["-gamma", f"{e['gamma']:.4f}"]
    return args


def apply_args(settings):
    """ImageMagick arguments that develop a negative with these settings."""
    chans = settings["channels"]
    if "base" not in chans[0]:
        return legacy_args(settings)

    def channel(ch):
        # Clamped between: brighter than the base is the base, and a build of
        # ImageMagick that keeps values above white would carry them into
        # the power.
        return ["-evaluate", "Divide", f"{max(ch['base'], 1) / 255.0:.5f}", "-clamp",
                "-evaluate", "Pow", f"{ch['power']:.4f}"]

    if settings["mode"] == "color":
        args = []
        for name, ch in zip("RGB", chans):
            args += ["-channel", name] + channel(ch)
        args += ["+channel"]
    else:
        args = ["-grayscale", "Average"] + channel(chans[0]) + ["-colorspace", "sRGB"]
    return args + ["-negate"] + exposure_args(settings)


def legacy_args(settings):
    """The recipe as it was before October 2026 (per-channel levels and
    gamma), for a frames.json not analysed since."""
    def level(ch):
        return ["-level", f"{ch['lo'] * 100.0 / 255:.4f}%,{ch['hi'] * 100.0 / 255:.4f}%"]

    if settings["mode"] == "color":
        args = []
        for name, ch in zip("RGB", settings["channels"]):
            args += ["-channel", name] + level(ch)
        args += ["+channel", "-negate"]
        for name, ch in zip("RGB", settings["channels"]):
            args += ["-channel", name, "-gamma", f"{ch['gamma']:.4f}"]
        return args + ["+channel"]

    ch = settings["channels"][0]
    args = ["-grayscale", "Average"] + level(ch) + ["-negate", "-colorspace", "sRGB"]
    if abs(ch["gamma"] - 1.0) > 1e-4:
        args += ["-gamma", f"{ch['gamma']:.4f}"]
    return args


def _log_mix(a, b, weight):
    return math.exp(math.log(max(a, 1e-6)) * weight + math.log(max(b, 1e-6)) * (1 - weight))


def blend(strip, frame, weight):
    """Weighted mix of two settings. weight=1 is all strip, 0 all frame.

    The colour of two frames of one roll is the same thing, so what this
    really mixes is their exposure: black and white points linearly, gammas
    in log space, because a gamma is a multiplicative exponent and averaging
    0.5 with 2.0 has to give 1.0.
    """
    mixed = {"mode": strip["mode"],
             "white": strip.get("white", 1.0) * weight + frame.get("white", 1.0) * (1 - weight),
             "channels": [{"base": a["base"] * weight + b["base"] * (1 - weight),
                           "power": _log_mix(a["power"], b["power"], weight)}
                          for a, b in zip(strip["channels"], frame["channels"])]}
    a, b = strip.get("exposure"), frame.get("exposure")
    if a and b:
        mixed["exposure"] = {
            "black": a["black"] * weight + b["black"] * (1 - weight),
            "white": a["white"] * weight + b["white"] * (1 - weight),
            "gamma": _log_mix(a["gamma"], b["gamma"], weight),
        }
    elif a or b:
        mixed["exposure"] = dict(a or b)
    return mixed


def mean_settings(items):
    """Quality-weighted mean of (settings, weight) pairs."""
    items = [(s, w) for s, w in items if s]
    if not items:
        return None
    total = sum(w for _, w in items)
    if total <= 0:
        total, items = float(len(items)), [(s, 1.0) for s, _ in items]
    first = items[0][0]
    mean = {"mode": first["mode"], "white": first.get("white", 1.0),
            "channels": [dict(ch) for ch in first["channels"]]}
    exposed = [(s["exposure"], w) for s, w in items if s.get("exposure")]
    if exposed:
        total = sum(w for _, w in exposed) or float(len(exposed))
        mean["exposure"] = {
            "black": sum(e["black"] * w for e, w in exposed) / total,
            "white": sum(e["white"] * w for e, w in exposed) / total,
            "gamma": math.exp(sum(math.log(max(e["gamma"], 1e-6)) * w for e, w in exposed) / total),
        }
    return mean


def quality(contrast):
    """0..1 score for how well exposed a frame is.

    Judged purely on how much tone the negative carries, measured as the
    interquartile spread. Deliberately *not* on where the midtone sits: a
    frame's key is the photographer's choice, and penalising it marks a
    correctly exposed low-key or high-key shot as a failure. What actually
    distinguishes a bad frame is that there is little tone in it at all —
    which is what a blank, thin or blown negative looks like.
    """
    return round(min(1.0, contrast / HEALTHY_CONTRAST), 4)


# --- roll layout --------------------------------------------------------

def strip_scans(roll_dir):
    files = []
    for ext in SCAN_EXTS:
        for pat in (ext, ext.upper()):
            files += glob.glob(os.path.join(roll_dir, "*." + pat))
    return sorted(set(files))


def roll_mode(roll_dir):
    name = os.path.basename(os.path.normpath(roll_dir)).lower()
    return "color" if name.endswith("_color") or name.endswith("_colour") else "bw"


def roll_format(roll_dir):
    name = os.path.basename(os.path.normpath(roll_dir)).lower()
    for fmt in FRAMES_PER_STRIP:
        if f"_{fmt}_" in name:
            return fmt
    return None


def frames_json_path(roll_dir):
    return os.path.join(roll_dir, "frames.json")


def load_frames_json(roll_dir):
    path = frames_json_path(roll_dir)
    if not os.path.exists(path):
        return None
    with open(path) as fh:
        return json.load(fh)


# --- frame splitting ----------------------------------------------------

def density_profile(path, axis_len, across_len, vertical):
    """Mean film brightness along the strip's long axis, at analysis scale.

    Non-film pixels are left out, so the scanner bed along one edge cannot
    drag a row's mean. The inter-frame rebate shows up as a bright band,
    because it is bare film base with no image on it.
    """
    rgb = read_rgb(path)
    grey = read_grey(path)
    w = int(round(across_len * ANALYSIS_SCALE / 100.0)) if vertical else \
        int(round(axis_len * ANALYSIS_SCALE / 100.0))
    if w <= 0:
        return [], 0
    total = len(grey)
    h = total // w if w else 0
    if h <= 0:
        return [], 0

    sums = [0.0] * (h if vertical else w)
    counts = [0] * len(sums)
    for i, _, _, _ in film_pixels(rgb):
        px = i // 3
        if px >= total:
            break
        y, x = divmod(px, w)
        slot = y if vertical else x
        if slot < len(sums):
            sums[slot] += grey[px]
            counts[slot] += 1
    profile = [(sums[i] / counts[i]) if counts[i] else 0.0 for i in range(len(sums))]
    return profile, counts


def film_extent(profile, counts):
    """First and last slot along the axis that holds a useful amount of film."""
    if not counts:
        return 0, len(profile)
    peak = max(counts)
    if peak <= 0:
        return 0, len(profile)
    threshold = peak * 0.35
    idx = [i for i, c in enumerate(counts) if c >= threshold]
    if not idx:
        return 0, len(profile)

    # First to last, except for a scrap at either end that stands well apart
    # from the rest: beyond a strip shorter than its holder there is bare
    # glass and then the holder's far end, which is dim enough to pass for
    # film. A stretch of clear film between pictures is not that: there is
    # more film after it than a scrap.
    per_mm = (STRIP_DPI / 25.4) * (ANALYSIS_SCALE / 100.0)
    scrap, apart = 8.0 * per_mm, 8.0 * per_mm
    islands, start, last = [], idx[0], idx[0]
    for i in idx[1:]:
        if i - last > 2:
            islands.append((start, last + 1))
            start = i
        last = i
    islands.append((start, last + 1))
    while len(islands) > 1 and islands[-1][1] - islands[-1][0] < scrap and \
            islands[-1][0] - islands[-2][1] >= apart:
        islands.pop()
    while len(islands) > 1 and islands[0][1] - islands[0][0] < scrap and \
            islands[1][0] - islands[0][1] >= apart:
        islands.pop(0)
    return islands[0][0], islands[-1][1]


def interior_rebate(profile, bounds):
    """Strongest bright band inside each frame, relative to how bright this
    strip's own frame boundaries are.

    This is the check that a frame count is *wrong*. A rebate cutting through
    the middle of what we think is one photograph means the split does not
    line up with the film — which is what a 620 roll of 8 exposures does when
    it is split 3-per-strip. Detecting the right count outright is not
    reliable (bright sky reads like bare film base, sprocket holes add their
    own rhythm on 35mm, and any divisor of the true count lines up too), but
    noticing a cut through the middle of a frame is.
    """
    edges = bounds[1:-1]
    if not edges:
        return [0.0] * max(0, len(bounds) - 1)
    # Reference: how bright this strip's own frame boundaries are. Bare film
    # base is the brightest thing on a strip, so anything inside a frame that
    # matches it is another boundary — while a bright sky, which is what makes
    # a fixed threshold misfire, stays well below it.
    ref = sorted(profile[e] for e in edges)[len(edges) // 2]
    if ref <= 0:
        return [0.0] * (len(bounds) - 1)

    lifts = []
    for i in range(len(bounds) - 1):
        a, b = bounds[i], bounds[i + 1]
        inset = int((b - a) * 0.22)   # stay well clear of the real boundaries
        segment = profile[a + inset:b - inset]
        lifts.append(max(segment) / ref if len(segment) >= 5 else 0.0)
    return lifts


def suggest_frame_count(strips, max_n=8):
    """Largest count at or below max_n that cuts through no frame.

    Only trustworthy *downward*, which is why callers pass the count that was
    actually used as the ceiling: splitting into more frames than the film
    holds can still line up (six cuts include the three real ones), so a
    higher suggestion would not mean anything.
    """
    best = None
    for n in range(1, max_n + 1):
        ok = True
        for profile, counts in strips:
            bounds, _ = find_boundaries(profile, counts, n)
            if any(l >= SPLIT_WARN_LIFT for l in interior_rebate(profile, bounds)):
                ok = False
                break
        if ok:
            best = n
    return best


def fit_grid(profile, start, end, n_frames):
    """Best (origin, pitch) for a regular grid of n_frames across the strip.

    Frames are evenly spaced, but they are *not* guaranteed to start where the
    film does: a strip with blank leader at one end shifts every boundary, and
    dividing the film extent into n equal parts then cuts through the middle of
    every frame. So both the pitch and the phase get fitted, scored by how much
    rebate brightness the interior boundaries land on.
    """
    span = end - start
    even = span / float(n_frames)
    best, best_score = (start, even), -1.0
    for pitch_step in range(-12, 13):                 # pitch within ±12%
        pitch = even * (1.0 + pitch_step / 100.0)
        if pitch <= 2:
            continue
        slack = span - pitch * n_frames
        if slack < -pitch * 0.15:                     # grid cannot overrun the film
            continue
        for phase_step in range(0, 13):
            origin = start + max(0.0, slack) * phase_step / 12.0
            edges = [origin + i * pitch for i in range(1, n_frames)]
            if any(e <= start or e >= end for e in edges):
                continue
            score = sum(profile[int(round(e))] for e in edges) / len(edges)
            if score > best_score:
                best, best_score = (origin, pitch), score
    return best


def find_boundaries(profile, counts, n_frames):
    """Interior frame boundaries, from a fitted grid then nudged onto the
    rebate. Returns (boundaries in profile slots, per-boundary refined flags).

    The grid gives the regular spacing that film transport guarantees; the
    rebate is what marks each individual cut, so each boundary still gets to
    move a little onto the nearest bright band.
    """
    start, end = film_extent(profile, counts)
    span = end - start
    if span <= 0 or n_frames < 2:
        return [start, end], []

    origin, pitch = fit_grid(profile, start, end, n_frames)
    # Scaled to the frame, not the strip: a fraction of the whole strip is far
    # too tight a window on a 6-frame strip and too loose on a 2-frame one.
    window = max(2, int(pitch * REFINE_WINDOW))
    first = max(start, int(round(origin)))
    last = min(end, int(round(origin + pitch * n_frames)))
    bounds, refined = [first], []
    for i in range(1, n_frames):
        seed = int(round(origin + i * pitch))
        lo = max(first + 1, seed - window)
        hi = min(last - 1, seed + window)
        if hi <= lo:
            bounds.append(seed)
            refined.append(False)
            continue
        segment = profile[lo:hi + 1]
        best = max(range(len(segment)), key=lambda k: segment[k])
        neighbourhood = sorted(segment)[len(segment) // 2]
        if neighbourhood > 0 and segment[best] >= neighbourhood * REBATE_LIFT:
            bounds.append(lo + best)
            refined.append(True)
        else:
            bounds.append(seed)          # keep the fitted position, but say so
            refined.append(False)
    bounds.append(last)
    return bounds, refined


def frame_regions(path, n_frames):
    """Pixel regions for each frame in a strip, plus the refinement flags."""
    w, h = dimensions(path)
    vertical = h >= w
    axis_len, across_len = (h, w) if vertical else (w, h)
    profile, counts = density_profile(path, axis_len, across_len, vertical)
    if not profile:
        return [], [], vertical, (w, h), (profile, counts), []

    bounds, refined = find_boundaries(profile, counts, n_frames)
    scale = axis_len / float(len(profile))
    regions = []
    for i in range(len(bounds) - 1):
        a = int(round(bounds[i] * scale))
        b = int(round(bounds[i + 1] * scale))
        a, b = max(0, a), min(axis_len, b)
        if b - a < 8:
            continue
        if vertical:
            regions.append((0, a, w, b - a))
        else:
            regions.append((a, 0, b - a, h))
    cuts = interior_rebate(profile, bounds)
    return regions, refined, vertical, (w, h), (profile, counts), cuts


def rebate_rows(path, vertical, base):
    """How much of each line across the strip is as bright as bare film,
    0..255, along the strip's long axis at full resolution.

    A frame's picture always has something darker than the base somewhere
    across it; the rebate between frames, and the glass beyond the film's
    end, do not. That makes this a much sharper trace of the gaps than the
    mean brightness, which a bright sky can lift as high as a gap.
    """
    w, h = dimensions(path)
    threshold = max(base * 0.90, 1.0) * 100.0 / 255.0
    geometry = f"1x{h}!" if vertical else f"{w}x1!"
    out = _magick([path, "-alpha", "off", "-grayscale", "Average",
                   "-threshold", f"{threshold:.2f}%", "-scale", geometry,
                   "-depth", "8", "gray:-"])
    return list(out)


def _smooth(values, half):
    out, total, n = [], 0, len(values)
    prefix = [0]
    for v in values:
        total += v
        prefix.append(total)
    for i in range(n):
        a, b = max(0, i - half), min(n, i + half + 1)
        out.append((prefix[b] - prefix[a]) / float(b - a))
    return out


def grid_35mm(rows, start, end):
    """Where 35mm's fixed 38 mm grid sits on a strip: (first gap, pitch,
    found). The pitch is the film's own; only a fraction of a percent of
    play is allowed for the scanner. `found` is False when no phase stands
    out (a blank strip, or one all of night), and the grid is then laid
    from where the film starts, which is where strips are cut."""
    pitch0 = PITCH_35MM / 25.4 * STRIP_DPI
    gap = GAP_35MM / 25.4 * STRIP_DPI
    smooth = _smooth(rows, int(gap / 2))
    n = len(smooth)

    scores, best = [], (-1.0, float(start), pitch0)
    for step in range(-4, 5):
        pitch = pitch0 * (1.0 + step * 0.002)
        phase = 0.0
        while phase < pitch:
            first = phase + math.ceil((start - gap - phase) / pitch) * pitch
            picks, x = [], first
            while x <= end + gap:
                if 0 <= int(x) < n:
                    picks.append(smooth[int(x)])
                x += pitch
            if len(picks) >= 2:
                score = sum(picks) / len(picks)
                scores.append(score)
                if score > best[0]:
                    best = (score, first, pitch)
            phase += 2.0

    if not scores:
        return float(start), pitch0, False
    ordinary = sorted(scores)[len(scores) // 2]
    if best[0] - ordinary < 30.0:
        return float(start), pitch0, False
    return best[1], best[2], True


def frames_35mm(rows, start, end, w, h, vertical):
    """Picture rectangles on a 35mm strip, and whether the grid was found."""
    first, pitch, found = grid_35mm(rows, start, end)
    gap = GAP_35MM / 25.4 * STRIP_DPI
    clear = EDGE_CLEAR_MM / 25.4 * STRIP_DPI
    reach = int(1.0 / 25.4 * STRIP_DPI)
    smooth = _smooth(rows, int(gap / 2))

    def settle(x):
        """A gap's centre, nudged onto the brightest of the rebate near it."""
        if not found:
            return x
        lo, hi = max(0, int(x) - reach), min(len(smooth) - 1, int(x) + reach)
        if hi <= lo:
            return x
        peak = max(range(lo, hi + 1), key=lambda i: smooth[i])
        return float(peak) if smooth[peak] >= 128 else x

    across = h if not vertical else w
    side = int(round(across * SIDE_INSET))
    regions = []
    a = first - pitch * math.ceil((first - start) / pitch + 1)
    while a < end:
        b = a + pitch
        if min(b, end) - max(a, start) >= MIN_CELL * pitch:
            lo = max(settle(a) + gap / 2 + clear, start)
            hi = min(settle(b) - gap / 2 - clear, end)
            lo, hi = int(round(lo)), int(round(hi))
            if hi - lo >= 8:
                if vertical:
                    regions.append((side, lo, w - 2 * side, hi - lo))
                else:
                    regions.append((lo, side, hi - lo, h - 2 * side))
        a = b
    return regions, found


def trim_to_pictures(bounds, rows, w, h, vertical):
    """Frame rectangles from fitted boundaries (full-resolution positions),
    with the rebate either side of each cut, and at the strip's two ends,
    left out."""
    # Only a line that is bare film right across is rebate. A thin frame has
    # stretches that nearly are, and a looser test eats into the picture.
    clear = EDGE_CLEAR_MM / 25.4 * STRIP_DPI
    far_gap = int(3.5 / 25.4 * STRIP_DPI)
    far_end = int(8.0 / 25.4 * STRIP_DPI)
    bare = 238
    n = len(rows)

    def run(x, step, limit, level):
        i, moved = int(x), 0
        while 0 <= i + step < n and moved < limit and rows[i + step] >= level:
            i += step
            moved += 1
        return i

    edges = []   # (end of the frame before, start of the frame after) per boundary
    for k, e in enumerate(bounds):
        e = min(max(int(e), 0), n - 1)
        if k == 0:
            edges.append((None, run(e, 1, far_end, bare) + clear if rows[e] >= bare else e))
        elif k == len(bounds) - 1:
            e = min(e, n - 1)
            edges.append((run(e - 1, -1, far_end, bare) - clear if rows[e - 1] >= bare else e, None))
        elif rows[e] >= bare:
            edges.append((run(e, -1, far_gap, bare) - clear, run(e, 1, far_gap, bare) + clear))
        else:
            edges.append((e, e))

    across = h if not vertical else w
    side = int(round(across * SIDE_INSET))
    regions = []
    for k in range(len(bounds) - 1):
        lo, hi = int(round(edges[k][1])), int(round(edges[k + 1][0]))
        if hi - lo < 8:
            continue
        if vertical:
            regions.append((side, lo, w - 2 * side, hi - lo))
        else:
            regions.append((lo, side, hi - lo, h - 2 * side))
    return regions


def stats_crop(region, vertical):
    """Region shrunk away from its edges, so neither the rebate at its ends
    nor the holder's shadow along its sides enters the stats."""
    x, y, w, h = region
    if vertical:
        along, across = int(h * STATS_INSET), int(w * STATS_SIDE)
        return (x + across, y + along, max(1, w - 2 * across), max(1, h - 2 * along))
    along, across = int(w * STATS_INSET), int(h * STATS_SIDE)
    return (x + along, y + across, max(1, w - 2 * along), max(1, h - 2 * across))


# --- subcommands --------------------------------------------------------

def strip_entry(doc, src):
    if not doc:
        return None
    name = os.path.basename(src)
    return next((s for s in doc["strips"] if s["file"] == name), None)


def cmd_strips(args):
    """Develop strip scans into positives.

    With no frame analysis this measures each strip as a whole, which is a
    compromise whenever one strip holds frames of different exposure — a dark
    frame beside two bright ones drags the recipe off all three. When the roll
    has been analysed, each frame is instead developed on its own settings and
    laid back into place, so the sheet shows every frame at its own best. The
    frames still lean on their strip's recipe by --frame-weight, which keeps
    siblings looking like they came off the same roll.
    """
    os.makedirs(args.dest, exist_ok=True)
    doc = load_frames_json(args.roll) if args.roll else None
    film = doc.get("film") if doc else None
    wrong = set(doc.get("mis_split") or []) if doc else set()

    for src in args.scans:
        dst = os.path.join(args.dest,
                           os.path.splitext(os.path.basename(src))[0] + ".png")
        entry = strip_entry(doc, src)
        split_ok = entry and os.path.basename(src) not in wrong

        # The strip as a whole: the roll's colour when the roll has been
        # analysed, so a strip that could not be cut into frames still
        # matches its neighbours; read on its own only when there is no roll.
        if split_ok and entry.get("settings"):
            whole = entry["settings"]
        elif film:
            whole = frame_settings(film, *histograms(src))
        else:
            whole, _, _ = measure(src, args.mode)
        base = apply_args(whole) if whole else ["-negate"]

        frames = [f for f in entry["frames"] if f.get("settings")] if split_ok else []
        if not frames or not whole:
            _magick([src] + base + [dst])
            continue

        # Strip first, so the rebate between frames still gets developed, then
        # each frame composited over its own patch of it.
        cmd = [src] + base
        for f in frames:
            x, y, w, h = f["region"]
            mixed = blend(whole, f["settings"], args.frame_weight)
            cmd += ["("] + [src] + _crop_args((x, y, w, h)) + apply_args(mixed) + \
                   [")", "-geometry", f"+{x}+{y}", "-composite"]
        _magick(cmd + [dst])
    return 0


def cmd_analyze(args):
    roll_dir = os.path.abspath(args.roll)
    scans = strip_scans(roll_dir)
    if not scans:
        print(f"error: no strip scans in {roll_dir}", file=sys.stderr)
        return 1

    mode = args.mode or roll_mode(roll_dir)
    fmt = roll_format(roll_dir)
    # A count corrected once has to stay corrected: 620 holds 8 or 12
    # exposures depending on the camera, so the format default is only a
    # guess, and re-analysing must not quietly undo the right answer.
    previous = (load_frames_json(roll_dir) or {}).get("frames_per_strip")
    per_strip = args.frames_per_strip or previous or FRAMES_PER_STRIP.get(fmt)
    if not per_strip:
        print(f"error: cannot tell how many frames per strip for '{fmt or 'this format'}'; "
              f"pass --frames-per-strip N", file=sys.stderr)
        return 1
    if not args.frames_per_strip and previous and previous != FRAMES_PER_STRIP.get(fmt):
        print(f"(using {previous} frames/strip, remembered from the last analysis)")

    if args.export:
        os.makedirs(args.export, exist_ok=True)

    # 35mm is cut on its own grid unless a count is insisted on (a half-frame
    # camera, say). What an earlier analysis remembered does not count as
    # insisting: every 35mm roll remembers the six it was once assumed to be.
    on_grid = fmt == "35mm" and not args.frames_per_strip

    doc = {
        "roll": os.path.basename(roll_dir)[4:7],
        "folder": os.path.basename(roll_dir),
        "mode": mode,
        "frames_per_strip": per_strip,
        "strips": [],
    }

    # First the geometry and the readings, strip by strip; the colour comes
    # after, from all of them together.
    found, profiles, mis_split, unaligned = [], [], [], []
    for index, scan in enumerate(scans):
        w, h = dimensions(scan)
        vertical = h >= w
        axis_len, across_len = (h, w) if vertical else (w, h)
        prof = density_profile(scan, axis_len, across_len, vertical)
        profile, counts = prof
        profiles.append(prof)
        whole = histograms(scan)
        base = pct(whole[1], whole[2], 100 - CLIP) if whole[2] else 255
        refined, regions = [], []
        if profile:
            rows = rebate_rows(scan, vertical, base)
            scale = axis_len / float(len(profile))
            start, end = film_extent(profile, counts)
            if on_grid:
                regions, aligned = frames_35mm(rows, int(start * scale), int(end * scale),
                                               w, h, vertical)
                refined = [aligned] * max(0, len(regions) - 1)
                if not aligned and regions:
                    unaligned.append(os.path.basename(scan))
            else:
                bounds, refined = find_boundaries(profile, counts, per_strip)
                if any(c >= SPLIT_WARN_LIFT for c in interior_rebate(profile, bounds)):
                    mis_split.append(os.path.basename(scan))
                regions = trim_to_pictures([b * scale for b in bounds], rows, w, h, vertical)

        frames = []
        for region in regions:
            hist, ghist, kept = histograms(scan, stats_crop(region, vertical))
            contrast = interquartile(ghist, kept) if kept else 0
            frames.append({"region": region, "read": (hist, ghist, kept),
                           "contrast": contrast, "score": quality(contrast) if kept else 0.0})
        found.append({"scan": scan, "index": index, "size": (w, h), "vertical": vertical,
                      "refined": refined, "whole": whole, "frames": frames})

    film = film_model(
        mode,
        [f["read"] + (f["score"],) for s in found for f in s["frames"]],
        [s["whole"] + (1.0,) for s in found])
    if film:
        doc["film"] = film
    if on_grid:
        doc["frames_per_strip"] = max([len(s["frames"]) for s in found] + [1])
        per_strip = doc["frames_per_strip"]

    print(f"{doc['folder']}  mode={mode}  " +
          ("frames on the 38 mm grid" if on_grid else f"{per_strip} frames/strip"))
    number = 0
    for s in found:
        scan, w, h = s["scan"], s["size"][0], s["size"][1]
        frames = []
        for f in s["frames"]:
            number += 1
            hist, ghist, kept = f["read"]
            if not kept or not film:
                frames.append({"frame": number, "region": list(f["region"]),
                               "quality": 0.0, "well_exposed": False,
                               "settings": None})
                continue
            settings = frame_settings(film, hist, ghist, kept, f["score"])
            frames.append({
                "frame": number,
                "region": list(f["region"]),
                "quality": f["score"],
                "well_exposed": f["score"] >= WELL_EXPOSED,
                "contrast": f["contrast"],
                "settings": settings,
                "stats": [[pct(hist[c], kept, CLIP), pct(hist[c], kept, 100 - CLIP),
                           pct(hist[c], kept, 50)] for c in range(3)] if mode == "color"
                         else [[pct(ghist, kept, CLIP), pct(ghist, kept, 100 - CLIP),
                                pct(ghist, kept, 50)]],
            })
            if args.export:
                _magick([scan] + _crop_args(f["region"]) + apply_args(settings) +
                        ["-resize", "600x600>",
                         os.path.join(args.export, f"frame-{number:02d}.png")])

        # Quality-weighted so a blown or blank frame cannot set the strip's
        # recipe, while still contributing a little.
        strip_settings = mean_settings(
            [(f.get("settings"), f["quality"] + 0.05) for f in frames])
        if not strip_settings and film:
            strip_settings = frame_settings(film, *s["whole"])
        well = sum(1 for f in frames if f["well_exposed"])
        doc["strips"].append({
            "file": os.path.basename(scan),
            "index": s["index"],
            "width": w, "height": h,
            "axis": "y" if s["vertical"] else "x",
            "refined": s["refined"],
            "well_exposed": well,
            "settings": strip_settings,
            "frames": frames,
        })

        note = ""
        if os.path.basename(scan) in unaligned:
            note = "  [no frame lines found: grid laid from the film's end]"
        elif not on_grid and not all(s["refined"]):
            note = f"  [{s['refined'].count(False)} boundary(s) not found — even split used]"
        print(f"  {os.path.basename(scan)}: {well}/{len(frames)} well exposed{note}")
        for f in frames:
            mark = "*" if f["well_exposed"] else " "
            print(f"      {mark} frame {f['frame']:>2}  quality {f['quality']:.2f}")

    if unaligned:
        doc["unaligned"] = unaligned

    if mis_split:
        hint = suggest_frame_count(profiles, max_n=per_strip)
        print()
        print(f"WARNING: a frame boundary runs through the middle of a frame on "
              f"{', '.join(mis_split)}.")
        print(f"         {per_strip} frames/strip does not match this film.", end="")
        if hint and hint != per_strip:
            print(f" Try --frames-per-strip {hint}.")
        else:
            print(" Set --frames-per-strip to the right count.")
        print("         The frames and settings below are split wrong until you do.")
        doc["mis_split"] = mis_split

    # Written beside and moved into place: a frame may be developing off the
    # old file while this one is being written, and half a file is no file.
    path = frames_json_path(roll_dir)
    with open(path + ".partial", "w") as fh:
        json.dump(doc, fh, indent=2)
    os.replace(path + ".partial", path)
    total = sum(len(s["frames"]) for s in doc["strips"])
    good = sum(s["well_exposed"] for s in doc["strips"])
    print(f"Wrote frames.json — {total} frame(s), {good} well exposed.")
    return 1 if mis_split else 0


def find_frame(doc, number):
    """(strip, frame) for a frame number, or (None, None)."""
    for strip in doc["strips"]:
        for frame in strip["frames"]:
            if frame["frame"] == number:
                return strip, frame
    return None, None


def cmd_preview(args):
    """Develop one frame straight off its strip scan — no rescan involved.

    Used to put the right negative in front of you at scan time, so the
    holder gets loaded by looking at the picture rather than counting frames.
    """
    roll_dir = os.path.abspath(args.roll)
    doc = load_frames_json(roll_dir)
    if not doc:
        print(f"error: no frames.json in {roll_dir}", file=sys.stderr)
        return 1
    strip, frame = find_frame(doc, args.frame)
    if not frame or not frame.get("settings"):
        print(f"error: roll has no analysed frame {args.frame}", file=sys.stderr)
        return 1
    _magick([os.path.join(roll_dir, strip["file"])] +
            _crop_args(tuple(frame["region"])) +
            apply_args(frame["settings"]) +
            ["-resize", f"{args.max}x{args.max}>", args.out])
    print(args.out)
    return 0


def remove_dust(path):
    """Takes small white specks off a developed frame, in place.

    Dust and fibres on the film block the lamp, so they scan dark and print
    white. A speck is a small patch far brighter than what surrounds it:
    wherever the frame stands well above its own local median, and the patch
    is too small for an opening to keep, the median is put there instead.
    Anything larger is picture (a lamp, a window) and is left alone, and
    nothing is ever darkened that was not a bright speck.
    """
    _magick([path,
             "(", "+clone", "-statistic", "Median", f"{DUST_MEDIAN}x{DUST_MEDIAN}", ")",
             "(", "-clone", "0", "-clone", "1", "-compose", "MinusSrc", "-composite",
             "-colorspace", "Gray", "-threshold", f"{DUST_LIFT}%", ")",
             "(", "-clone", "2", "-morphology", "Open", f"Disk:{DUST_MAX_RADIUS}", ")",
             "(", "-clone", "2", "-clone", "3", "-compose", "MinusSrc", "-composite",
             "-morphology", "Dilate", "Disk:1.5", ")",
             "-delete", "2,3",
             "-compose", "Over", "-composite", path])


def cmd_develop(args):
    roll_dir = os.path.abspath(args.roll)
    doc = load_frames_json(roll_dir)
    if not doc:
        print(f"error: no frames.json in {roll_dir}; run 'negatives --analyze' first",
              file=sys.stderr)
        return 1

    strip, frame = find_frame(doc, args.frame)
    if not strip or not strip.get("settings"):
        print(f"error: roll has no analysed frame {args.frame}", file=sys.stderr)
        return 1

    if doc.get("film") and frame.get("settings"):
        # The colour is the frame's, which is the roll's. The exposure is read
        # off this scan, which sees far more of the frame than the strip did,
        # away from its edges, and leans on the strip's by the weight given.
        w, h = dimensions(args.raw)
        inset = (int(w * 0.06), int(h * 0.06), int(w * 0.88), int(h * 0.88))
        hist, ghist, kept = histograms(args.raw, inset)
        # The colour is the frame's as analysed. Only the exposure is read
        # again, off this scan, which sees far more of the frame than the
        # strip did.
        own = dict(frame["settings"])
        own["exposure"] = exposure_for(own, hist, ghist, kept)
        settings = blend(dict(strip["settings"], channels=own["channels"]), own, args.weight)
    else:
        own, _, _ = measure(args.raw, doc["mode"])
        settings = blend(strip["settings"], own, args.weight) if own else strip["settings"]

    out_dir = args.out or os.path.join(roll_dir, "frames")
    os.makedirs(out_dir, exist_ok=True)
    dst = os.path.join(out_dir, f"{args.frame:02d}.png")
    _magick([args.raw] + apply_args(settings) + [dst])
    if args.dust:
        remove_dust(dst)
    print(f"Developed frame {args.frame} at weight {args.weight:.2f} -> {dst}")
    return 0


def main():
    p = argparse.ArgumentParser(prog="film-develop", description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("strips", help="turn strip scans into positives")
    s.add_argument("dest")
    s.add_argument("scans", nargs="+")
    s.add_argument("--mode", choices=["color", "bw"], required=True)
    s.add_argument("--roll", help="roll folder; uses its frames.json if present")
    s.add_argument("--frame-weight", type=float, default=0.35,
                   help="how much each frame leans on its strip's recipe "
                        "(1 = strip only, the pre-analysis look)")
    s.set_defaults(func=cmd_strips)

    a = sub.add_parser("analyze", help="split strips into frames and read them")
    a.add_argument("roll")
    a.add_argument("--frames-per-strip", type=int)
    a.add_argument("--mode", choices=["color", "bw"])
    a.add_argument("--export", help="also write developed frame crops here")
    a.set_defaults(func=cmd_analyze)

    v = sub.add_parser("preview", help="develop one frame off its strip scan")
    v.add_argument("--roll", required=True)
    v.add_argument("--frame", type=int, required=True)
    v.add_argument("--out", required=True)
    v.add_argument("--max", type=int, default=900)
    v.set_defaults(func=cmd_preview)

    d = sub.add_parser("develop", help="develop one high-resolution frame scan")
    d.add_argument("raw")
    d.add_argument("--roll", required=True)
    d.add_argument("--frame", type=int, required=True)
    d.add_argument("--weight", type=float, default=0.3,
                   help="how much the strip's exposure leads over the frame's "
                        "own (default 0.3)")
    d.add_argument("--out")
    d.add_argument("--no-dust", dest="dust", action="store_false",
                   help="leave white specks where they are")
    d.set_defaults(func=cmd_develop)

    args = p.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
